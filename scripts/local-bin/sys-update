#!/usr/bin/env bash
# A failed update or validation must never be reported as successful.
set -Eeuo pipefail
umask 077
if [[ ${1:-} == --check ]]; then
    exec sudo "$HOME/.local/bin/verify-kernel-stack"
fi
[[ $# == 0 ]] || { echo 'Usage: sys-update [--check]'; exit 2; }
for command_name in yay snapper dkms modinfo lsinitcpio; do command -v "$command_name" >/dev/null; done
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/workstation-updates"
mkdir -p "$state_dir"
logfile="$state_dir/$(date +%Y%m%d-%H%M%S).log"
exec > >(tee -a "$logfile") 2>&1
phase=preparation
pre_snapshot=
finish() {
    local result=$?
    trap - EXIT
    if [[ -n "$pre_snapshot" ]]; then
        if ! sudo snapper -c root create --type post --pre-number "$pre_snapshot" --cleanup-algorithm number --description "sys-update result=$result"; then
            echo 'ERROR: could not create the post-update snapshot.'
            result=1
        fi
    fi
    if (( result == 0 )); then
        echo 'Update and kernel validation completed. Reboot if kernel/driver packages changed.'
    else
        printf 'FAILED during %s. Exit status: %s. No reboot was performed.\n' "$phase" "$result"
    fi
    printf 'Log: %s\n' "$logfile"
    exit "$result"
}
trap finish EXIT
sudo -v
phase=snapshot
pre_snapshot=$(sudo snapper -c root create --type pre --print-number --cleanup-algorithm number --description "Before sys-update $(date --iso-8601=seconds)")
[[ "$pre_snapshot" =~ ^[0-9]+$ ]] || { echo 'Invalid pre-update snapshot number'; exit 1; }
phase=packages
yay -Syu
phase=kernel-validation
if ! sudo "$HOME/.local/bin/verify-kernel-stack"; then
    echo 'Kernel validation failed; attempting one DKMS/initramfs repair.'
    sudo dkms autoinstall
    sudo mkinitcpio -P
    sudo "$HOME/.local/bin/verify-kernel-stack"
fi
phase=complete
