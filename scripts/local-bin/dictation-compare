  def compare(self,*_):
   self.cancel.clear();self.run.set_sensitive(False);self.record.set_sensitive(False);self.open.set_sensitive(False);self.text='';self.results.get_buffer().set_text('')
   reference=self.reference.get_text();audio=self.audio;output=self.output;profiles=SETS[self.profile_set.get_active_text()];self.profile_set.set_sensitive(False)
