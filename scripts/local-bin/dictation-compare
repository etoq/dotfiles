def words(text):return re.findall(r'[\w]+',text.casefold())

def score(reference,text):
 a,b=words(reference),words(text)
 if not a:return {'wer_percent':None,'terms_correct':None,'terms_total':None}
 row=list(range(len(b)+1))
 for i,w in enumerate(a,1):
  new=[i]
  for j,v in enumerate(b,1):new.append(min(new[-1]+1,row[j]+1,row[j-1]+(w!=v)))
  row=new
 terms=(ASSETS/'terms.txt').read_text().splitlines()
 def includes(haystack,needle):return (' '+ ' '.join(words(needle))+' ') in (' '+' '.join(words(haystack))+' ')
 expected=[term for term in terms if term and includes(reference,term)]
 return {'wer_percent':round(100*row[-1]/len(a),1),'terms_correct':sum(includes(text,term) for term in expected),'terms_total':len(expected)}


def folder():
 p=DATA/'runs'/(datetime.datetime.now().strftime('%Y%m%d-%H%M%S')+'-'+uuid.uuid4().hex[:6]);p.mkdir(parents=True,mode=0o700);return p


def validate_wav(path):
 with wave.open(str(path),'rb') as f:
  if (f.getnchannels(),f.getframerate(),f.getsampwidth())!=(1,16000,2):raise ValueError('Нужен WAV PCM16, 16000 Гц, mono.')
  if f.getnframes()==0:raise ValueError('Запись пустая.')


def command(profile,path):
 if profile=='medium-gpu':return [str(H/'.local/bin/dictation-turbo-engine'),str(path),'--model','medium','--device','vulkan']
 if profile.startswith('turbo-'):
  return [str(H/'.local/bin/dictation-turbo-engine'),str(path),'--model','base' if '-base-' in profile else 'codeswitch','--device','cpu' if profile.endswith('-cpu') else 'vulkan']
 model=PROFILES[profile][1]
 if model:return [str(H/'.local/bin/handy'),'--transcribe-file',str(path),'--model',model,'--repeat','2','--json']
 return [str(H/'.local/share/hyprwhspr/venv/bin/python'),str(H/'.local/bin/dictation-compare-engine'),str(path)]


def run_all(path,reference,out,update=lambda *_:None,cancel=None,profiles=None):
 validate_wav(path);out.mkdir(parents=True,exist_ok=True,mode=0o700)
 with path.open('rb') as stream:digest=hashlib.file_digest(stream,'sha256').hexdigest()
 (out/'audio-source.json').write_text(json.dumps({'path':str(path.resolve()),'sha256':digest},ensure_ascii=False,indent=2))
 (out/'reference.txt').write_text(reference);rows=[]
 for profile in (profiles if profiles is not None else list(PROFILES)[:4]):
  name=PROFILES[profile][0]
  if cancel and cancel.is_set():break
  update(name,'Вычисляю…');start=time.monotonic()
  with (out/(profile+'.log')).open('wb') as log:
   proc=sp.Popen(command(profile,path),stdout=sp.PIPE,stderr=log)
   try:
    while True:
     try:raw,_=proc.communicate(timeout=.2);break
     except sp.TimeoutExpired:
      if (cancel and cancel.is_set()) or time.monotonic()-start>900:raise RuntimeError('Тест остановлен.')
   except BaseException:
    proc.terminate()
    try:proc.communicate(timeout=5)
    except sp.TimeoutExpired:proc.kill();proc.communicate()
    raise
  if proc.returncode:
   result={'profile':profile,'name':name,'error':'Ошибка движка; смотри '+profile+'.log'}
  else:
   try:
    result=json.loads(raw);result.update(profile=profile,name=name,total_seconds=round(time.monotonic()-start,2));result.update(score(reference,result['text']))
   except (ValueError,KeyError):result={'profile':profile,'name':name,'error':'Некорректный ответ движка; смотри журнал.'}
  rows.append(result);(out/'results.json').write_text(json.dumps(rows,ensure_ascii=False,indent=2));update(name,result)
 with (out/'results.csv').open('w') as stream:
  fields=['name','wer_percent','terms_correct','terms_total','load_ms','transcribe_ms','total_seconds','text','error'];writer=csv.DictWriter(stream,fieldnames=fields,extrasaction='ignore');writer.writeheader();writer.writerows(rows)
 return rows


def render(result):
 if result.get('error'):return result['error']
 times=result.get('transcribe_ms',[]);secs=' / '.join(f'{n/1000:.2f}' for n in times)
 return f"WER {result['wer_percent']}% · термины {result['terms_correct']}/{result['terms_total']}\nЗагрузка {result.get('load_ms',0)/1000:.2f} с · распознавание 1/2: {secs} с\n{result['text']}"


