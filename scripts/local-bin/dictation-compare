 'handy-whisper':('Handy · Whisper Medium Q5_K_M','handy-computer/whisper-medium-gguf/whisper-medium-Q5_K_M.gguf'),
 'hypr-whisper':('hyprwhspr · Whisper Medium Q5_0',None),
 'turbo-base-gpu':('Turbo · обычная · Vulkan Q5_0',None),
 'turbo-code-gpu':('Turbo · RU+EN техническая · Vulkan Q5_0',None),
 'turbo-base-cpu':('Turbo · обычная · CPU Q5_0',None),
 'turbo-code-cpu':('Turbo · RU+EN техническая · CPU Q5_0',None),
