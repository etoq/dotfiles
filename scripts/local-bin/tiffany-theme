#!/usr/bin/env python3
"""Apply the shared Black Tiffany palette to existing text-based UI configurations."""
import argparse,json,re
from pathlib import Path
H=Path.home();R=H/'dotfiles';P=H/'.config/tiffany/palette.json'
DEFAULT={'background':'#080D10','surface':'#101B20','border':'#183039','accent':'#0ABAB5','cyan':'#4DDDD5','mint':'#A3F0E7','foreground':'#C5D6D8','muted':'#7E999F','cpu':'#C99070','audio':'#D35F5E','success':'#8DC99B','warning':'#D8B77B','error':'#DE7C86','blue':'#79A9D1','hover':'#21414B','bright':'#DFE9E9'}
parser=argparse.ArgumentParser();parser.add_argument('--apply',action='store_true');args=parser.parse_args()
new=json.loads(P.read_text());state=H/'.local/state/tiffany/palette-applied.json'
if set(new)!=set(DEFAULT) or not all(isinstance(c,str) and re.fullmatch('#[0-9A-Fa-f]{6}',c) for c in new.values()):raise SystemExit('Invalid palette: expected the existing keys and #RRGGBB values')
old=json.loads(state.read_text()) if state.exists() else DEFAULT
mapping={old[k].lower().lstrip('#'):new[k].lstrip('#').upper() for k in DEFAULT}
def replace(match):
 text=match.group();raw=text.lstrip('#');alpha=raw[:2] if len(raw)==8 else '';rgb=raw[-6:].lower()
 return ('#' if text.startswith('#') else '')+alpha+mapping[rgb] if rgb in mapping else text
files=[R/'configs'/p for p in ['awesome/theme.lua','awesome/rc.lua','polybar/config.ini','panel-lab/dashboard.css','bspwm/bspwmrc','picom/picom.conf','dunst/dunstrc','kitty/kitty.conf','kitty/otter.conf','fish/config.fish','fish/tiffany.fish','Xresources','gtk-3.0/gtk.css','gtk-4.0/gtk.css','nvim/lua/core/colors.lua','otter-launcher/config.toml','rofi/config.rasi','rofi/dracula.rasi','rofi/catppuccin.rasi']]
files += [R/'scripts/local-bin/panel-data',R/'scripts/local-bin/polybar-workspaces',R/'themes/Ghidra/BlackTiffany.theme']
files += list((R/'themes/Black-Tiffany').rglob('*.css'))
changed=0
for p in files:
 if not p.is_file():continue
 before=p.read_text();after=re.sub(r'(?<![\w])#?[0-9A-Fa-f]{8}(?![\w])|(?<![\w])#?[0-9A-Fa-f]{6}(?![\w])',replace,before)
 ansi_map={';'.join(str(int(old[k][i:i+2],16)) for i in (1,3,5)):';'.join(str(int(new[k][i:i+2],16)) for i in (1,3,5)) for k in DEFAULT}
 after=re.sub(r'38;2;(\d+;\d+;\d+)m',lambda m:'38;2;'+ansi_map.get(m[1],m[1])+'m',after)
 if after!=before:
  changed+=1
  if args.apply:p.write_text(after)
if args.apply:
 state.parent.mkdir(parents=True,exist_ok=True);state.write_text(json.dumps(new,indent=2)+'\n')
print(('Applied' if args.apply else 'Would update')+f' palette: {changed} configuration files. Source: {P}')
