#!/usr/bin/env python3
"""Read-only validation of installed Arch kernels, NVIDIA DKMS and initramfs."""
import re,subprocess as sp,sys
from pathlib import Path
errors=[];kernels=[]
def run(args):return sp.run(args,capture_output=True,text=True,timeout=45)
dkms=run(['dkms','status']).stdout
for p in sorted(Path('/usr/lib/modules').glob('*/pkgbase')):
 base=p.read_text().strip()
 if base not in ('linux','linux-lts'):continue
 k=p.parent.name;kernels.append(k)
 for module in ('nvidia','nvidia_drm','nvidia_modeset','nvidia_uvm'):
  r=run(['modinfo','-k',k,'-F','vermagic',module])
  if r.returncode or not r.stdout.startswith(k+' '):errors.append(f'{k}: missing or mismatched {module}')
 if not any(l.startswith('nvidia/') and ', '+k+',' in l and l.rstrip().endswith(': installed') for l in dkms.splitlines()):errors.append(f'{k}: NVIDIA DKMS is not installed')
 image=Path('/boot')/f'initramfs-{base}.img'
 if not image.is_file() or image.stat().st_size==0:errors.append(f'{k}: missing initramfs')
 else:
  r=run(['lsinitcpio',str(image)])
  if r.returncode:errors.append(f'{k}: cannot read initramfs ({r.stderr.strip()[:120]})')
  elif not any('/modules/'+k+'/' in l for l in r.stdout.splitlines()):errors.append(f'{k}: initramfs does not contain its kernel modules')
 print(f'Checked {base}: {k}')
if not kernels:errors.append('No installed Arch kernel pkgbase files found')
if errors:
 for e in errors:print('ERROR:',e,file=sys.stderr)
 sys.exit(1)
print('OK: installed kernels, NVIDIA modules and initramfs match.')
