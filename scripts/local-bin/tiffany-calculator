#!/usr/bin/env python3
"""Non-modal Black Tiffany calculator; qalc handles expressions, never Python eval."""
import json
import os
from pathlib import Path
import re
import sys
import tempfile

import gi
gi.require_version('Gtk', '3.0')
gi.require_version('Gdk', '3.0')
from gi.repository import Gdk, Gio, GLib, Gtk, Pango

os.umask(0o077)
STATE = Path(os.environ.get('XDG_STATE_HOME', Path.home() / '.local/state')) / 'otter-tools'
HISTORY = STATE / 'calc-history.json'
CSS = b'''
