 border-radius: 9px; padding: 12px; caret-color: #4DDDD5; font: 17px monospace; }
.calculator entry:focus { border-color: #0ABAB5; box-shadow: none; }
.calculator button { background: #101B20; color: #C5D6D8; border: 1px solid #183039;
 border-radius: 8px; padding: 8px 13px; box-shadow: none; text-shadow: none; }
