def read_history():
    try:
        data = json.loads(HISTORY.read_text())
        if isinstance(data, list):
            return [row for row in data if isinstance(row, list) and len(row) == 2
                    and all(isinstance(value, str) for value in row)][-30:]
    except (OSError, ValueError):
        pass
    return []


def save_history(history):
    STATE.mkdir(parents=True, exist_ok=True, mode=0o700)
    fd, temporary = tempfile.mkstemp(prefix='.calc-history-', dir=STATE)
    try:
        with os.fdopen(fd, 'w') as stream:
            json.dump(history[-30:], stream, ensure_ascii=False)
        os.replace(temporary, HISTORY)
    finally:
        Path(temporary).unlink(missing_ok=True)


class CalculatorWindow(Gtk.ApplicationWindow):
    def __init__(self, application):
        super().__init__(application=application, title='Калькулятор · Black Tiffany')
        self.set_wmclass('tiffany-calculator', 'TiffanyCalculator')
        self.set_role('tiffany-calculator')
        self.set_default_size(620, 570)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.get_style_context().add_class('calculator')
        self.history = read_history()
        self.answer = ''
        self.job = None
        self.timeout = None
        self.closed = False

        body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        body.set_border_width(24)
        self.add(body)
        heading = Gtk.Label(label='Калькулятор', xalign=0)
        heading.get_style_context().add_class('heading')
        body.pack_start(heading, False, False, 0)
        subtitle = Gtk.Label(label='Числа · единицы измерения · HEX / DEC', xalign=0)
        subtitle.get_style_context().add_class('muted')
        body.pack_start(subtitle, False, False, 0)

        input_row = Gtk.Box(spacing=10)
        self.entry = Gtk.Entry()
        self.entry.set_placeholder_text('2+2 · 0xFF to dec · 10 km to m')
        self.entry.set_icon_from_icon_name(Gtk.EntryIconPosition.SECONDARY, 'edit-clear-symbolic')
        self.entry.connect('icon-release', lambda *_: self.clear_entry())
        self.entry.connect('activate', lambda *_: self.compute())
        input_row.pack_start(self.entry, True, True, 0)
        self.compute_button = Gtk.Button(label='Вычислить')
        self.compute_button.get_style_context().add_class('primary')
        self.compute_button.connect('clicked', lambda *_: self.compute())
        input_row.pack_start(self.compute_button, False, False, 0)
        body.pack_start(input_row, False, False, 0)

        result_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=9)
        result_box.get_style_context().add_class('result')
        self.expression_label = Gtk.Label(label='Результат', xalign=0)
        self.expression_label.set_ellipsize(Pango.EllipsizeMode.MIDDLE)
        self.expression_label.get_style_context().add_class('muted')
        result_box.pack_start(self.expression_label, False, False, 0)
        self.result = Gtk.TextView(editable=False, cursor_visible=False)
        self.result.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
        self.result.set_accepts_tab(False)
        result_scroll = Gtk.ScrolledWindow()
        result_scroll.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        result_scroll.set_min_content_height(65)
        result_scroll.add(self.result)
        result_box.pack_start(result_scroll, True, True, 0)
        result_actions = Gtk.Box(spacing=8)
        self.copy_button = Gtk.Button(label='Скопировать')
        self.copy_button.connect('clicked', lambda *_: self.copy_result())
        self.continue_button = Gtk.Button(label='Продолжить с ans')
        self.continue_button.connect('clicked', lambda *_: self.continue_result())
        result_actions.pack_start(self.copy_button, False, False, 0)
        result_actions.pack_start(self.continue_button, False, False, 0)
        result_box.pack_start(result_actions, False, False, 0)
        body.pack_start(result_box, False, False, 0)

        self.status = Gtk.Label(label='Enter — вычислить · Ctrl+L — новый ввод · Esc — закрыть', xalign=0)
        self.status.get_style_context().add_class('muted')
        self.status.set_line_wrap(True)
        body.pack_start(self.status, False, False, 0)
        history_heading = Gtk.Box()
        history_heading.pack_start(Gtk.Label(label='История', xalign=0), True, True, 0)
        clear = Gtk.Button(label='Очистить историю')
        clear.connect('clicked', lambda *_: self.clear_history())
        history_heading.pack_end(clear, False, False, 0)
        body.pack_start(history_heading, False, False, 0)
        self.history_list = Gtk.ListBox()
        self.history_list.connect('row-activated', self.restore_history)
        history_scroll = Gtk.ScrolledWindow()
        history_scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        history_scroll.set_min_content_height(150)
        history_scroll.add(self.history_list)
        body.pack_start(history_scroll, True, True, 0)
        self.rebuild_history()
        self.set_result('', 'Результат')
        self.connect('key-press-event', self.on_key)
        self.connect('destroy', self.on_destroy)

    def set_status(self, text, error=False):
        style = self.status.get_style_context()
        (style.add_class if error else style.remove_class)('error')
        self.status.set_text(text)

    def set_result(self, answer, expression):
        self.answer = answer
        self.result.get_buffer().set_text(answer)
        self.expression_label.set_text(expression)
        self.copy_button.set_sensitive(bool(answer))
        self.continue_button.set_sensitive(bool(answer))

    def stop_job(self):
        if self.timeout:
            GLib.source_remove(self.timeout)
            self.timeout = None
        if self.job:
            self.job.force_exit()
            self.job = None
        if not self.closed:
            self.compute_button.set_sensitive(True)
            self.entry.set_sensitive(True)

    def compute(self):
        expression = self.entry.get_text().strip()
        if not expression:
            return
        if re.search(r'\bans\b', expression):
            if not self.answer:
                self.set_status('Сначала вычисли результат для ans.', True)
                return
            expression = re.sub(r'\bans\b', lambda _: '(' + self.answer + ')', expression)
        self.stop_job()
        self.entry.set_sensitive(False)
        self.compute_button.set_sensitive(False)
        self.set_status('Вычисляю…')
        try:
            process = Gio.Subprocess.new(['qalc', '-t', '-m', '3000', '--', expression],
                                        Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_PIPE)
        except GLib.Error as error:
            self.entry.set_sensitive(True)
            self.compute_button.set_sensitive(True)
            self.set_status(str(error), True)
            return
        self.job = process
        timed_out = [False]

        def timeout():
            self.timeout = None
            timed_out[0] = True
            process.force_exit()
            return False

        def done(proc, result):
            try:
                _, output, error = proc.communicate_utf8_finish(result)
            except GLib.Error as failure:
                output, error = '', str(failure)
            if self.closed or self.job is not proc:
                return
            self.job = None
            if self.timeout:
                GLib.source_remove(self.timeout)
                self.timeout = None
            self.entry.set_sensitive(True)
            self.compute_button.set_sensitive(True)
            answer = (output or '').strip()
            if timed_out[0]:
                self.set_status('Вычисление остановлено: превышено 8 секунд.', True)
            elif not proc.get_successful() or not answer or re.search(r'error:|ошибка:', answer + (error or ''), re.I):
                self.set_status((error or answer or 'Не удалось вычислить выражение.').strip()[:500], True)
            else:
                self.set_result(answer, expression)
                self.history = [row for row in self.history if row[0] != expression] + [[expression, answer]]
                self.history = self.history[-30:]
                try:
                    save_history(self.history)
                    self.set_status('Готово · ans — последний результат')
                except OSError as failure:
                    self.set_status('Результат готов, но история не сохранена: ' + str(failure), True)
                self.rebuild_history()

        self.timeout = GLib.timeout_add_seconds(8, timeout)
        process.communicate_utf8_async(None, None, done)

    def copy_result(self):
        if self.answer:
            clipboard = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
            clipboard.set_text(self.answer, -1)
            clipboard.store()
            self.set_status('Результат скопирован')

    def continue_result(self):
        if self.answer:
            self.entry.set_text('ans ')
            self.entry.set_position(-1)
            self.entry.grab_focus()

    def clear_entry(self):
        self.stop_job()
        self.entry.set_text('')
        self.entry.grab_focus()

    def rebuild_history(self):
        for child in self.history_list.get_children():
            self.history_list.remove(child)
        for expression, answer in reversed(self.history):
            row = Gtk.ListBoxRow()
            row.values = (expression, answer)
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            for value, style in ((expression, 'muted'), (answer, 'history-result')):
                label = Gtk.Label(label=value, xalign=0)
                label.set_ellipsize(Pango.EllipsizeMode.END)
                label.set_max_width_chars(60)
                label.get_style_context().add_class(style)
                box.pack_start(label, False, False, 0)
            row.add(box)
            self.history_list.add(row)
        self.history_list.show_all()

    def restore_history(self, _, row):
        self.stop_job()
        expression, answer = row.values
        self.entry.set_text(expression)
        self.set_result(answer, expression)
        self.entry.grab_focus()
        self.entry.set_position(-1)

    def clear_history(self):
        try:
            save_history([])
        except OSError as failure:
            self.set_status(str(failure), True)
            return
        self.history = []
        self.rebuild_history()
        self.set_status('История очищена')

    def on_key(self, _, event):
        control = event.state & Gdk.ModifierType.CONTROL_MASK
        if event.keyval == Gdk.KEY_Escape:
            self.close()
            return True
        if control and event.keyval in (Gdk.KEY_l, Gdk.KEY_L):
            self.clear_entry()
            return True
        if control and event.state & Gdk.ModifierType.SHIFT_MASK and event.keyval in (Gdk.KEY_c, Gdk.KEY_C):
            self.copy_result()
            return True
        return False

    def on_destroy(self, *_):
        self.closed = True
        self.stop_job()


class CalculatorApp(Gtk.Application):
    def __init__(self):
        super().__init__(application_id='org.eto.TiffanyCalculator', flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        self.window = None

    def do_startup(self):
        Gtk.Application.do_startup(self)
        css = Gtk.CssProvider()
        css.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    def do_activate(self):
        if self.window is None or self.window.closed:
            self.window = CalculatorWindow(self)
        self.window.show_all()
        self.window.present()
        self.window.entry.grab_focus()

    def do_command_line(self, command_line):
        expression = ' '.join(command_line.get_arguments()[1:]).strip()
        self.activate()
        if expression:
            self.window.entry.set_text(expression)
            self.window.compute()
        return 0


if __name__ == '__main__':
    raise SystemExit(CalculatorApp().run(sys.argv))
