#!/usr/bin/env python3
"""Open existing desktop apps and reconnect GUI services after a new login."""
import argparse
import contextlib
import fcntl
import json
import os
from pathlib import Path
import re
import subprocess as sp
import sys
import time

HOME = Path.home()
LAUNCH = {'chatgpt': ['/usr/bin/chatgpt'], 'discord': ['/usr/bin/discord'], 'localsend': ['/usr/bin/localsend'], 'throne': ['/usr/bin/throne']}
CLASSES = {'chatgpt': 'chatgpt', 'discord': 'discord', 'localsend': 'org.localsend.localsend_app', 'throne': 'throne'}


def run(args, timeout=4):
    return sp.run([str(x) for x in args], text=True, capture_output=True, timeout=timeout)


def app_of_pid(pid):
    try:
        proc = Path('/proc') / str(int(pid))
        if proc.stat().st_uid != os.getuid():
            return None
        exe = (proc / 'exe').resolve(strict=True)
        if exe == Path('/usr/lib/throne/Throne'):
            return 'throne'
        if exe == Path('/opt/localsend/localsend'):
            return 'localsend'
        if exe == Path('/usr/lib/chatgpt/ChatGPT'):
            return 'chatgpt'
        if exe.name == 'Discord' and (
                exe.parent in (Path('/opt/discord'), Path('/usr/share/discord'))
                or (exe.parent.parent == HOME / '.config/discord'
                    and re.fullmatch(r'app-[0-9.]+', exe.parent.name))):
            return 'discord'
    except (OSError, ValueError):
        pass
    return None


def main_processes(app):
    result = []
    for proc in Path('/proc').iterdir():
        if not proc.name.isdigit() or app_of_pid(proc.name) != app:
            continue
        try:
            # Chromium may put its entire process title in argv[0].
            args = (proc / 'cmdline').read_bytes().replace(b'\0', b' ')
            if not re.search(rb'(?:^|\s)--type=', args):
                result.append(int(proc.name))
        except OSError:
            continue
    return result


def window_info(window):
    props = run(['xprop', '-id', str(int(window)), 'WM_CLASS', '_NET_WM_PID', '_NET_WM_WINDOW_TYPE'])
    if props.returncode:
        return None
    pid = re.search(r'_NET_WM_PID\(CARDINAL\) = (\d+)', props.stdout)
    classes = re.search(r'WM_CLASS\(STRING\) = (.*)', props.stdout)
    names = re.findall(r'"([^"\n]*)"', classes[1]) if classes else []
    if not pid or not names:
        return None
    app = app_of_pid(int(pid[1]))
    if app not in LAUNCH or names[-1].lower() != CLASSES[app]:
        return None
    return {'window': int(window), 'pid': int(pid[1]), 'app': app,
            'normal': '_NET_WM_WINDOW_TYPE_NORMAL' in props.stdout}


def windows(app):
    matches = run(['xdotool', 'search', '--class', '^' + re.escape(CLASSES[app]) + '$'])
    result = []
    for window in matches.stdout.splitlines():
        if not window.isdigit():
            continue
        info = window_info(window)
        if not info or info['app'] != app or not info['normal']:
            continue
        geometry = run(['xdotool', 'getwindowgeometry', '--shell', window])
        fields = dict(line.split('=', 1) for line in geometry.stdout.splitlines() if '=' in line)
        width, height = int(fields.get('WIDTH', 0)), int(fields.get('HEIGHT', 0))
        # Exclude Electron clipboard/tray/helper windows, including unmapped ones.
        if width >= 320 and height >= 240:
            info['area'] = width * height
            result.append(info)
    return sorted(result, key=lambda item: item['area'], reverse=True)


def managed_windows(app):
    props = run(['xprop', '-root', '_NET_CLIENT_LIST'])
    ids = {int(token, 16) for token in re.findall(r'0x[0-9a-fA-F]+', props.stdout)}
    return [item for item in windows(app) if item['window'] in ids]


def activate(window):
    window = int(window)
    desktop = os.environ.get('XDG_CURRENT_DESKTOP', '').lower()
    code = ("for _,c in ipairs(client.get())do if c.window==" + str(window)
                + " then c.minimized=false;c.hidden=false;"
                "if c.first_tag then c.first_tag:view_only()end;"
                "client.focus=c;c:raise();return true end end;return false")
    # A managed window on another tag is intentionally unmapped by the WM.
    # Switch its tag first instead of waiting for it to become viewable.
    if 'awesome' in desktop and 'boolean true' in run(['awesome-client', code]).stdout:
        return
    if 'bspwm' in desktop and run(['bspc', 'node', hex(window), '-f']).returncode == 0:
        return
    focused = run(['xdotool', 'windowactivate', '--sync', str(window)])
    if focused.returncode:
        raise RuntimeError('Не удалось переключиться на окно.')


def tray_open_id(layout):
    """Accept only an explicit Open/Show item, never the adjacent Quit item."""
    try:
        children = layout['data'][1][2]
        for child in children:
            item_id, properties, _ = child['data']
            label = properties.get('label', {}).get('data', '').replace('_', '').strip().casefold()
            enabled = properties.get('enabled', {}).get('data', True)
            visible = properties.get('visible', {}).get('data', True)
            if (type(item_id) is int and enabled and visible and label in
                    {'открыть', 'показать', 'open', 'show', 'open localsend', 'show localsend'}):
                return item_id
    except (KeyError, IndexError, TypeError, AttributeError, ValueError):
        pass
    return None


def activate_localsend():
    """Invoke LocalSend's tray Open callback; GTK Activate starts another Flutter engine."""
    pids = set(main_processes('localsend'))
    if not pids:
        return False
    names = run(['busctl', '--user', '--no-pager', '--no-legend', 'list'])
    for line in names.stdout.splitlines():
        fields = line.split()
        if len(fields) < 2 or not re.fullmatch(r':[0-9]+\.[0-9]+', fields[0]):
            continue
        if not fields[1].isdigit() or int(fields[1]) not in pids:
            continue
        name = fields[0]
        objects = run(['busctl', '--user', '--list', 'tree', name])
        for path in objects.stdout.splitlines():
            path = path.strip()
            if not (path.startswith('/org/ayatana/NotificationItem/') and path.endswith('/Menu')):
                continue
            menu = run(['busctl', '--user', '--json=short', 'call', name, path,
                        'com.canonical.dbusmenu', 'GetLayout', 'iias', '0', '1', '3',
                        'label', 'enabled', 'visible'])
            if menu.returncode:
                continue
            try:
                item_id = tray_open_id(json.loads(menu.stdout))
            except ValueError:
                continue
            if item_id is None:
                continue
            result = run(['busctl', '--user', 'call', name, path,
                          'com.canonical.dbusmenu', 'Event', 'isvu', str(item_id),
                          'clicked', 's', '', '0'])
            if result.returncode == 0:
                return True
    raise RuntimeError('LocalSend запущен, но пункт «Открыть» в трее не найден. Процесс не перезапускался.')


SERVICES = {name: name + '.service' for name in (
    'throne', 'idle-screen-lock', 'easyeffects', 'udiskie', 'wispr-flow')}


def process_display(pid):
    try:
        proc = Path('/proc') / str(pid)
        if proc.stat().st_uid != os.getuid():
            return ''
        fields = dict(item.split(b'=', 1) for item in (proc / 'environ').read_bytes().split(b'\0') if b'=' in item)
        return fields.get(b'DISPLAY', b'').decode()
    except (OSError, ValueError):
        return ''


def service_displays(properties):
    pid = properties.get('MainPID', '0')
    found = {process_display(pid)} if pid != '0' else set()
    group = properties.get('ControlGroup', '')
    prefix = f'/user.slice/user-{os.getuid()}.slice/'
    if group.startswith(prefix) and '..' not in group.split('/'):
        try:
            for child in (Path('/sys/fs/cgroup') / group.lstrip('/') / 'cgroup.procs').read_text().split():
                found.add(process_display(child))
        except OSError:
            pass
    return found - {''}


def ensure_gui_service(name):
    unit = SERVICES[name]
    display = os.environ.get('DISPLAY', '')
    if not display:
        raise RuntimeError('Для запуска приложения нужен графический сеанс.')
    result = run(['systemctl', '--user', 'show', unit, '-p', 'MainPID', '-p', 'ControlGroup'])
    if result.returncode:
        raise RuntimeError('Не удалось проверить службу ' + unit)
    props = dict(line.split('=', 1) for line in result.stdout.splitlines() if '=' in line)
    old_displays = service_displays(props)
    # A user manager survives while a TTY login remains open. Its GUI clients
    # must reconnect to the current X server instead of the abandoned one.
    action = 'restart' if old_displays and old_displays != {display} else 'start'
    names = [key for key in ('DISPLAY', 'XAUTHORITY', 'XDG_SESSION_ID', 'XDG_CURRENT_DESKTOP', 'XDG_SESSION_TYPE') if key in os.environ]
    imported = run(['systemctl', '--user', 'import-environment', *names])
    if imported.returncode:
        raise RuntimeError('Не удалось обновить окружение графического сеанса.')
    result = run(['systemctl', '--user', action, unit], timeout=45)
    if result.returncode:
        raise RuntimeError(result.stderr.strip() or 'Не удалось запустить ' + unit)
    if action == 'restart':
        print('Reconnected ' + unit + ' to ' + display, flush=True)
    return action


def open_app(app):
    runtime = Path(os.environ.get('XDG_RUNTIME_DIR', HOME / '.cache')) / 'desktop-app'
    runtime.mkdir(mode=0o700, parents=True, exist_ok=True)
    with (runtime / (app + '.lock')).open('w') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return
        existing = managed_windows(app)
        if existing:
            activate(existing[0]['window'])
            return
        if app == 'throne':
            display = os.environ.get('DISPLAY', '')
            if not any(process_display(pid) == display for pid in main_processes('throne')):
                ensure_gui_service('throne')
                # Wait for Qt's primary instance before asking its IPC to show UI.
                deadline = time.monotonic() + 8
                while not any(process_display(pid) == display for pid in main_processes('throne')):
                    if time.monotonic() >= deadline:
                        raise RuntimeError('Throne service did not start on the current display.')
                    time.sleep(.1)
                time.sleep(.5)
        # When all windows were withdrawn to the tray, let Electron's native
        # single-instance IPC call BrowserWindow.show(). XMapWindow alone leaves
        # Electron's internal visibility state false and breaks menu accelerators.
        state = Path(os.environ.get('XDG_STATE_HOME', HOME / '.local/state')) / 'desktop-app'
        state.mkdir(mode=0o700, parents=True, exist_ok=True)
        restored = app == 'localsend' and activate_localsend()
        if not restored:
            with (state / (app + '.log')).open('ab') as log:
                sp.Popen(LAUNCH[app], stdin=sp.DEVNULL, stdout=log, stderr=log,
                         start_new_session=True)
        # Repeated hotkeys while startup is in progress never spawn another app.
        deadline = time.monotonic() + 12
        while time.monotonic() < deadline:
            existing = managed_windows(app)
            if existing:
                activate(existing[0]['window'])
                return
            time.sleep(.15)
        raise RuntimeError('Приложение запускается, но его окно пока не найдено. Повтори сочетание позже.')


def main():
    os.umask(0o077)
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest='command', required=True)
    cmd = commands.add_parser('open')
    cmd.add_argument('app', choices=LAUNCH)
    service = commands.add_parser('ensure-service')
    service.add_argument('app', choices=SERVICES)
    args = parser.parse_args()
    if args.command == 'ensure-service':
        ensure_gui_service(args.app)
    else:
        open_app(args.app)


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, RuntimeError, sp.SubprocessError) as error:
        print('Desktop app:', error, file=sys.stderr)
        with contextlib.suppress(OSError):
            sp.run(['notify-send', 'Ошибка запуска/закрытия', str(error)], check=False)
        sys.exit(1)
