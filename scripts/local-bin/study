#!/usr/bin/env python3
"""Work/rest countdowns with elapsed-time analytics; no input monitoring."""
import argparse
import contextlib
import curses
import datetime as dt
import fcntl
import json
import os
from pathlib import Path
import re
import signal
import sqlite3
import subprocess as sp
import sys
import time

STATE = Path(os.environ.get('XDG_STATE_HOME', Path.home() / '.local/state')) / 'study'
LABELS = {'work': 'Работа', 'rest': 'Отдых', 'none': 'Без аналитики'}
BOOT = Path('/proc/sys/kernel/random/boot_id').read_text().strip()


def database():
    os.umask(0o077)
    STATE.mkdir(mode=0o700, parents=True, exist_ok=True)
    db = sqlite3.connect(STATE / 'activity.sqlite3', timeout=5)
    db.row_factory = sqlite3.Row
    db.execute('PRAGMA journal_mode=WAL')
    # The old activity intervals/state are preserved, but excluded from timer reports.
    db.executescript("""
        CREATE TABLE IF NOT EXISTS timer_runs (
          id INTEGER PRIMARY KEY, kind TEXT NOT NULL CHECK(kind IN ('work','rest','none')),
          duration REAL NOT NULL CHECK(duration>0), elapsed REAL NOT NULL DEFAULT 0,
          status TEXT NOT NULL, wall REAL NOT NULL, mono REAL NOT NULL,
          boot TEXT NOT NULL, notified INTEGER NOT NULL DEFAULT 0);
        CREATE UNIQUE INDEX IF NOT EXISTS one_active_timer ON timer_runs((1))
          WHERE status IN ('running','paused');
        CREATE TABLE IF NOT EXISTS timer_intervals (
          id INTEGER PRIMARY KEY, run_id INTEGER NOT NULL, start REAL NOT NULL,
          end REAL NOT NULL, kind TEXT NOT NULL CHECK(kind IN ('work','rest')), CHECK(end>start));
        CREATE INDEX IF NOT EXISTS timer_interval_end ON timer_intervals(end);
    """)
    return db


def current_timer(db):
    row = db.execute("SELECT * FROM timer_runs WHERE status IN ('running','paused')").fetchone()
    return dict(row) if row else None


def record(db, run, start, end):
    if run['kind'] == 'none' or end <= start:
        return
    last = db.execute('SELECT id,end FROM timer_intervals WHERE run_id=? ORDER BY id DESC LIMIT 1',
                      (run['id'],)).fetchone()
    if last and abs(last['end']-start) < .01:
        db.execute('UPDATE timer_intervals SET end=? WHERE id=?', (end, last['id']))
    else:
        db.execute('INSERT INTO timer_intervals(run_id,start,end,kind) VALUES (?,?,?,?)',
                   (run['id'], start, end, run['kind']))


def advance(db, wall=None, mono=None, boot=None):
    """Called inside an immediate transaction, so UI and worker cannot double count."""
    wall = time.time() if wall is None else wall
    mono = time.monotonic() if mono is None else mono
    boot = BOOT if boot is None else boot
    run = current_timer(db)
    if not run:
        return
    if run['boot'] != boot or mono < run['mono']:
        db.execute("UPDATE timer_runs SET status='interrupted' WHERE id=?", (run['id'],))
        return
    if run['status'] == 'paused':
        return
    delta = mono-run['mono']
    amount = min(delta, max(0, run['duration']-run['elapsed']))
    # Monotonic time excludes suspend and ignores wall-clock adjustments.
    start = wall-delta
    record(db, run, start, start+amount)
    elapsed = min(run['duration'], run['elapsed']+amount)
    status = 'done' if elapsed >= run['duration'] else 'running'
    db.execute('UPDATE timer_runs SET elapsed=?,status=?,wall=?,mono=? WHERE id=?',
               (elapsed, status, wall, mono, run['id']))


@contextlib.contextmanager
def transaction(db):
    db.execute('BEGIN IMMEDIATE')
    try:
        yield
        db.commit()
    except BaseException:
        db.rollback()
        raise


def start_timer(db, kind, seconds, wall=None, mono=None, boot=None):
    if kind not in LABELS or not 1 <= seconds <= 7*86400:
        raise ValueError('Выбери тип и длительность таймера от секунды до 7 дней.')
    wall = time.time() if wall is None else wall
    mono = time.monotonic() if mono is None else mono
    boot = BOOT if boot is None else boot
    with transaction(db):
        advance(db, wall, mono, boot)
        if current_timer(db):
            raise RuntimeError('Таймер уже запущен. Сначала заверши или отмени его клавишей C.')
        db.execute("INSERT INTO timer_runs(kind,duration,status,wall,mono,boot) VALUES (?,?,'running',?,?,?)",
                   (kind, seconds, wall, mono, boot))


def control(db, action, wall=None, mono=None, boot=None):
    wall = time.time() if wall is None else wall
    mono = time.monotonic() if mono is None else mono
    boot = BOOT if boot is None else boot
    with transaction(db):
        advance(db, wall, mono, boot)
        run = current_timer(db)
        if not run:
            return
        state = {'pause': 'paused', 'resume': 'running', 'cancel': 'cancelled',
                 'interrupt': 'interrupted'}[action]
        db.execute('UPDATE timer_runs SET status=?,wall=?,mono=? WHERE id=?',
                   (state, wall, mono, run['id']))


def notify_timer(kind):
    with contextlib.suppress(OSError):
        sp.Popen(['notify-send', '-a', 'Study', 'Таймер завершён', LABELS[kind] + ' · время вышло.'],
                 stdout=sp.DEVNULL, stderr=sp.DEVNULL)


def daemon(db):
    with (STATE / 'daemon.lock').open('w') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise RuntimeError('Служба таймера уже запущена.')
        running = True
        def finish(*_):
            nonlocal running
            running = False
        for sig in (signal.SIGTERM, signal.SIGINT):
            signal.signal(sig, finish)
        print('Countdown worker ready; no keyboard/mouse monitoring.', flush=True)
        try:
            while running:
                with transaction(db):
                    advance(db)
                    notifications = db.execute("SELECT id,kind FROM timer_runs WHERE status='done' AND notified=0").fetchall()
                    db.execute("UPDATE timer_runs SET notified=1 WHERE status='done' AND notified=0")
                for row in notifications:
                    notify_timer(row['kind'])
                time.sleep(.5)
        finally:
            control(db, 'interrupt')


def ensure_service():
    sp.run(['systemctl', '--user', 'start', 'study.service'], check=True, timeout=8)


def daily_totals(db, now=None):
    now = time.time() if now is None else now
    today = dt.datetime.fromtimestamp(now).date()
    first = min(today-dt.timedelta(days=29), today.replace(day=1))
    totals = {first + dt.timedelta(days=i): {'work': 0., 'rest': 0.}
              for i in range((today-first).days+1)}
    boundaries = [(day, dt.datetime.combine(day, dt.time()).timestamp(),
                   dt.datetime.combine(day+dt.timedelta(days=1), dt.time()).timestamp())
                  for day in totals]
    for start, end, kind in db.execute('SELECT start,end,kind FROM timer_intervals WHERE end>? AND start<?',
                                     (boundaries[0][1], now)):
        for day, low, high in boundaries:
            totals[day][kind] += max(0, min(end, high, now)-max(start, low))
    return today, totals


def report(db, period='all', now=None):
    today, totals = daily_totals(db, now)
    periods = {'day': today, 'week': today-dt.timedelta(days=6),
               'month': today.replace(day=1), '30': today-dt.timedelta(days=29)}
    summary = {}
    for key, start in periods.items():
        summary[key] = {kind: sum(row[kind] for day, row in totals.items() if day >= start)
                        for kind in ('work', 'rest')}
    start = periods.get(period, today-dt.timedelta(days=29))
    rows = [{'date': day.isoformat(), **row} for day, row in totals.items() if day >= start]
    return {'summary_seconds': summary, 'days': rows, 'timer': current_timer(db)}


def hours(seconds):
    return f'{seconds / 3600:.2f} ч'


def report_lines(db, period='all'):
    data = report(db, period)
    rows = ['СТАТИСТИКА', '',
            f'{"Период":18} {"Работа":>12} {"Отдых":>12}']
    for key, label in [('day', 'Сегодня'), ('week', 'Последние 7 дней'),
                       ('month', 'Текущий месяц'), ('30', 'Последние 30 дней')]:
        total = data['summary_seconds'][key]
        rows.append(f'{label:18} {hours(total["work"]):>12} {hours(total["rest"]):>12}')
    rows += ['', f'{"Дата":18} {"Работа":>12} {"Отдых":>12}']
    for day in reversed(data['days']):
        rows.append(f'{dt.date.fromisoformat(day["date"]):%d.%m.%Y}        '
                    f'{hours(day["work"]):>12} {hours(day["rest"]):>12}')
    return rows


def duration(text):
    match = re.fullmatch(r'(\d+(?:\.\d+)?)([smh]?)', text.strip().lower())
    if not match:
        raise ValueError('Длительность: 25 (минут), 90s, 25m или 1h.')
    seconds = float(match[1]) * {'s': 1, '': 60, 'm': 60, 'h': 3600}[match[2]]
    if not 1 <= seconds <= 7*86400:
        raise ValueError('Таймер: от 1 секунды до 7 дней.')
    return seconds


def clock(seconds):
    seconds = max(0, int(seconds+.999))
    return f'{seconds//3600:02}:{seconds//60%60:02}:{seconds%60:02}'


def dashboard(screen, db, initial_kind=None, initial_seconds=None):
    with contextlib.suppress(curses.error):
        curses.curs_set(0)
    screen.timeout(250)
    if curses.has_colors():
        curses.start_color()
        curses.use_default_colors()
        curses.init_pair(1, curses.COLOR_CYAN, -1)
    page, offset, message = 'day', 0, ''

    def prompt(kind):
        if current_timer(db):
            raise RuntimeError('Таймер уже идёт. Сначала заверши или отмени его клавишей C.')
        screen.timeout(-1)
        screen.erase()
        with contextlib.suppress(curses.error):
            screen.addstr(1, 1, LABELS[kind] + ' · новый таймер')
            screen.addstr(3, 1, 'Длительность: минуты, 25m, 90s, 1h')
            screen.addstr(5, 1, '> ')
            screen.refresh()
            curses.curs_set(1)
        curses.echo()
        try:
            text = screen.getstr(30).decode().strip()
            if not text:
                return
            seconds = duration(text)
            ensure_service()
            start_timer(db, kind, seconds)
        finally:
            curses.noecho()
            with contextlib.suppress(curses.error):
                curses.curs_set(0)
            screen.timeout(250)

    if initial_kind:
        if initial_seconds is not None:
            ensure_service()
            start_timer(db, initial_kind, initial_seconds)
        else:
            try:
                prompt(initial_kind)
            except (ValueError, RuntimeError, sp.SubprocessError) as error:
                message = str(error)
    while True:
        screen.erase()
        height, width = screen.getmaxyx()
        run = current_timer(db)
        if run:
            paused = ' · ПАУЗА' if run['status']=='paused' else ''
            lines = ['ТАЙМЕР · ' + LABELS[run['kind']] + paused, '',
                     clock(run['duration']-run['elapsed']),
                     f'Прошло {clock(run["elapsed"])} из {clock(run["duration"])}', '']
        else:
            lines = ['ТАЙМЕР', '1 работа · 2 отдых · 3 без аналитики',
                     'Выбери тип и задай длительность.', '']
        lines += report_lines(db, page)
        footer = ['1/2/3 новый таймер · пробел пауза/продолжить · C отменить',
                  'D день · W 7 дней · M месяц · A 30 дней · ↑↓ прокрутка',
                  'Q закрыть окно — таймер продолжится в фоне', message]
        room = max(1, height-len(footer)-1)
        offset = min(offset, max(0, len(lines)-room))
        for row, line in enumerate(lines[offset:offset+room]):
            with contextlib.suppress(curses.error):
                screen.addnstr(row, 1, line, max(1, width-2),
                               curses.color_pair(1) if row == 0 and curses.has_colors() else 0)
        for row, line in enumerate(footer, max(0, height-len(footer))):
            with contextlib.suppress(curses.error):
                screen.addnstr(row, 1, line, max(1, width-2))
        screen.refresh()
        try:
            key = screen.get_wch()
        except curses.error:
            continue
        if isinstance(key, str):
            key = key.lower()
            key = ord({'в': 'd', 'ц': 'w', 'ь': 'm', 'ф': 'a', 'й': 'q', 'с': 'c'}.get(key, key))
        if key in (ord('q'), 27):
            return
        try:
            if key in (ord('1'), ord('2'), ord('3')):
                prompt({ord('1'): 'work', ord('2'): 'rest', ord('3'): 'none'}[key])
                offset, message = 0, ''
            elif key == ord(' '):
                if run:
                    control(db, 'resume' if run['status']=='paused' else 'pause')
            elif key == ord('c'):
                control(db, 'cancel')
                message = 'Таймер отменён. Сохранено только прошедшее время работы/отдыха.'
            elif key in (ord('d'), ord('w'), ord('m'), ord('a')):
                page = {ord('d'): 'day', ord('w'): 'week', ord('m'): 'month', ord('a'): '30'}[key]
                offset = 0
            elif key == curses.KEY_DOWN:
                offset += 1
            elif key == curses.KEY_UP:
                offset = max(0, offset-1)
        except (ValueError, RuntimeError, sp.SubprocessError, curses.error, UnicodeError) as error:
            message = str(error)


def main():
    parser = argparse.ArgumentParser(description='Таймеры работы, отдыха и без аналитики.')
    commands = parser.add_subparsers(dest='command')
    commands.add_parser('daemon', help='Фоновое выполнение только запущенных таймеров')
    for name in ('work', 'rest', 'timer'):
        cmd = commands.add_parser(name, help={'work': 'Таймер работы', 'rest': 'Таймер отдыха',
                                              'timer': 'Таймер без аналитики'}[name])
        cmd.add_argument('duration', nargs='?', help='Минуты или 25m / 90s / 1h')
    for name in ('pause', 'resume', 'cancel', 'status'):
        commands.add_parser(name)
    cmd = commands.add_parser('report', help='Статистика таймеров в часах')
    cmd.add_argument('period', choices=['day', 'week', 'month', '30', 'all'], default='all', nargs='?')
    cmd.add_argument('--json', action='store_true')
    args = parser.parse_args()
    db = database()
    try:
        if args.command == 'daemon':
            daemon(db)
        elif args.command in ('pause', 'resume', 'cancel'):
            control(db, args.command)
            print('Готово.')
        elif args.command == 'status':
            run = current_timer(db)
            print(f'{LABELS[run["kind"]]} · {clock(run["duration"]-run["elapsed"])} · {run["status"]}'
                  if run else 'Нет запущенного таймера.')
        elif args.command == 'report':
            print(json.dumps(report(db, args.period), ensure_ascii=False, indent=2) if args.json
                  else '\n'.join(report_lines(db, args.period)))
        elif args.command in ('work', 'rest', 'timer'):
            kind = 'none' if args.command == 'timer' else args.command
            seconds = duration(args.duration) if args.duration else None
            if sys.stdin.isatty() and sys.stdout.isatty():
                curses.wrapper(dashboard, db, kind, seconds)
            elif seconds is not None:
                ensure_service()
                start_timer(db, kind, seconds)
                print(LABELS[kind] + ' · ' + clock(seconds))
            else:
                raise ValueError('Укажи длительность: study ' + args.command + ' 25m')
        elif sys.stdin.isatty() and sys.stdout.isatty():
            curses.wrapper(dashboard, db)
        else:
            print('\n'.join(report_lines(db)))
    finally:
        db.close()


if __name__ == '__main__':
    try:
        main()
    except KeyboardInterrupt:
        pass
    except (OSError, sqlite3.Error, RuntimeError, ValueError, curses.error, sp.SubprocessError) as error:
        print('Study:', error, file=sys.stderr)
        sys.exit(1)
