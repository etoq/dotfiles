#!/usr/bin/env python3
"""Handy external paste: clipboard text; terminal-aware chord; never Enter."""
import json
from pathlib import Path
import subprocess as sp
import sys
text=sys.argv[1] if len(sys.argv)>1 else ''
if not text:raise SystemExit(0)
p=sp.run([str(Path.home()/'.local/bin/wispr-context'),'--json'],capture_output=True,text=True,timeout=3)
try:context=json.loads(p.stdout)
except ValueError:context={}
sp.run(['xclip','-selection','clipboard','-in'],input=text.encode(),stdout=sp.DEVNULL,stderr=sp.DEVNULL,check=True,timeout=3)
chord='ctrl+shift+v' if context.get('appName')=='Terminal' else 'ctrl+v'
sp.run(['xdotool','key','--clearmodifiers',chord],check=True,timeout=3)
