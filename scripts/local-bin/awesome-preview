#!/usr/bin/env python3
"""Launch the configured Awesome in a separate Xephyr window, keeping bspwm."""
from pathlib import Path
import os,subprocess as sp,sys,time,tempfile
H=Path.home()
def inside():
    env=os.environ.copy();folder=Path(sys.argv[2]);env.update(PANEL_WM='awesome',AWESOME_PREVIEW='1',
        PANEL_LAB_RUNTIME=str(folder/'runtime'),XDG_STATE_HOME=str(folder/'state'))
    env['XDG_CURRENT_DESKTOP']='awesome';env.pop('BSPWM_SOCKET',None)
    with (folder/'session.log').open('ab') as log:
        wm=sp.Popen(['awesome','-c',str(H/'.config/awesome/rc.lua')],env=env,stdout=log,stderr=log)
        try:
            time.sleep(1)
            sp.run([str(H/'.local/bin/panel-switch'),'start'],env=env,stdout=log,stderr=log,timeout=20)
            sp.Popen([str(H/'.local/bin/panel-dashboard')],env=env,stdout=log,stderr=log)
            wm.wait()
        finally:
            try:sp.run([str(H/'.local/bin/panel-switch'),'stop'],env=env,stdout=log,stderr=log,timeout=20)
            except sp.TimeoutExpired:pass
            if wm.poll() is None:wm.terminate();wm.wait(timeout=4)
    return
def main():
    if len(sys.argv)>1 and sys.argv[1]=='--inside':inside();return
    if not shutil.which('awesome'):sys.exit('Сначала установи awesome.')
    number=next(i for i in range(90,110) if not Path(f'/tmp/.X11-unix/X{i}').exists())
    root=H/'.local/state/panel-lab/awesome-previews';root.mkdir(parents=True,exist_ok=True)
    folder=Path(tempfile.mkdtemp(prefix='preview-',dir=root))
    env=dict(os.environ,DISPLAY=f':{number}')
    with (folder/'xephyr.log').open('ab') as log:
        x=sp.Popen(['Xephyr',f':{number}','-screen','1600x1000','-resizeable','-ac','-nolisten','tcp','-title','AwesomeWM · Tiffany · Ctrl+Shift: grab keyboard'],stdout=log,stderr=log)
        try:
            time.sleep(1)
            if x.poll() is not None:sys.exit('Xephyr не запустился: '+str(folder/'xephyr.log'))
            child=sp.Popen(['dbus-run-session','--',sys.executable,str(Path(__file__).resolve()),'--inside',str(folder)],env=env)
            try:child.wait()
            except KeyboardInterrupt:child.terminate();child.wait(timeout=5)
        finally:
            if x.poll() is None:x.terminate();x.wait(timeout=4)
    print('Предпросмотр завершён. Текущий оконный менеджер не менялся. Журнал:',folder)
if __name__=='__main__':main()
