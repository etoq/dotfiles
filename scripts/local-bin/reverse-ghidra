#!/usr/bin/env bash
set -euo pipefail
export _JAVA_AWT_WM_NONREPARENTING=1
manual="$HOME/Tools/ghidra/build/dist/ghidra_12.2_DEV/ghidraRun"
if [[ -x "$manual" ]]; then
    exec "$manual" "$@"
elif command -v ghidra >/dev/null 2>&1; then
    exec ghidra "$@"
elif command -v ghidraRun >/dev/null 2>&1; then
    exec ghidraRun "$@"
fi
notify-send 'Ghidra' 'Ghidra не установлена: установи пакет ghidra или восстанови ручную сборку.' || true
exit 127
