#!/usr/bin/env python3
"""Shuffle Black Tiffany wallpapers without repeats until the collection is exhausted."""
import argparse
import fcntl
import json
import os
from pathlib import Path
import random
import subprocess


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--restore', action='store_true', help='Reapply the current image without advancing')
    parser.add_argument('--list', action='store_true', help='List eligible images without changing anything')
    args = parser.parse_args()
    images = Path.home() / 'Images'
    candidates = sorted(str(p) for p in images.glob('tiffany-*')
                        if p.is_file() and p.suffix.lower() in ('.png', '.jpg', '.jpeg', '.webp'))
    if args.list:
        print('\n'.join(candidates))
        return
    if not candidates:
        raise SystemExit('No Black Tiffany wallpapers in ~/Images; current background preserved.')
    if not os.environ.get('DISPLAY'):
        raise SystemExit('No X11 display; current background preserved.')
    state_dir = Path(os.environ.get('XDG_STATE_HOME', Path.home() / '.local/state')) / 'wallpaper'
    state_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
    with (state_dir / 'lock').open('w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        state_file = state_dir / 'rotation.json'
        try:
            state = json.loads(state_file.read_text())
            if not isinstance(state, dict):
                state = {}
        except (OSError, ValueError):
            state = {}
        current = state.get('current')
        queue = state.get('remaining', [])
        if not isinstance(queue, list):
            queue = []
        queue = list(dict.fromkeys(p for p in queue if isinstance(p, str) and p in candidates))
        # Include newly added images in the next full shuffle; don't lose the current cycle.
        if args.restore and current in candidates:
            selected = current
        else:
            if not queue:
                queue = candidates.copy()
                random.SystemRandom().shuffle(queue)
                if len(queue) > 1 and queue[-1] == current:
                    queue[0], queue[-1] = queue[-1], queue[0]
            selected = queue.pop()
        subprocess.run(['feh', '--no-fehbg', '--bg-fill', selected], check=True, timeout=30)
        state = {'current': selected, 'remaining': queue}
        temporary = state_dir / 'rotation.json.tmp'
        with os.fdopen(os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), 'w') as output:
            json.dump(state, output, ensure_ascii=False, indent=2)
        temporary.replace(state_file)
        print(Path(selected).name)


if __name__ == '__main__':
    main()
