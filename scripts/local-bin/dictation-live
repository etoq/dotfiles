#!/usr/bin/env python3
"""Manual X11 dictation: toggle microphone, one Medium Vulkan pass, guarded paste."""
import argparse,array,fcntl,json,math,os,signal,socket,subprocess as sp,sys,tempfile,threading,time,wave
from pathlib import Path
H=Path.home();BASE=H/'.local/share/dictation-compare'
RUNTIME=Path(os.environ.get('XDG_RUNTIME_DIR',f'/run/user/{os.getuid()}'))/'dictation-live'
STATE=H/'.local/state/dictation-live'

def notify(text):
 sp.run(['notify-send','-a','Local Whisper','-t','3500','Whisper Medium',text],stdout=sp.DEVNULL,stderr=sp.DEVNULL,timeout=3)

def locked():
 return (RUNTIME.parent/'wispr-screen-lock.json').exists() or sp.run(['pgrep','-u',str(os.getuid()),'-x','i3lock'],stdout=sp.DEVNULL).returncode==0

def active_window():
 for _ in range(4):
  p=sp.run([str(H/'.local/bin/wispr-context'),'--json'],capture_output=True,text=True,timeout=3)
  try:info=json.loads(p.stdout)
  except ValueError:return None
  if not any(word in info.get('appName','').lower() for word in ('otter','launcher')):return info.get('windowId')
  time.sleep(.15)
 return None

def engine_command(wav):
 return [str(BASE/'whisper.cpp-build/bin/whisper-compare'),str(H/'.local/share/pywhispercpp/models/ggml-medium-q5_0.bin'),str(wav),str(BASE/'turbo/prompt.txt'),'vulkan','1']

def audible(wav):
 with wave.open(str(wav),'rb') as w:
  if (w.getnchannels(),w.getsampwidth(),w.getframerate())!=(1,2,16000):raise ValueError('Unsupported microphone format')
  data=array.array('h',w.readframes(w.getnframes()))
 if sys.byteorder!='little':data.byteswap()
 return len(data)>=3200 and math.sqrt(sum(x*x for x in data)/max(1,len(data)))/32768>.0015

class Session:
 def __init__(self):
  self.lock=threading.RLock();self.phase='idle';self.recorder=None;self.engine=None;self.worker=None;self.cancelled=threading.Event();self.tmp=None;self.target=None;self.started=0;self.last_press=0
 def status(self):return {'phase':self.phase,'model':'Medium Q5_0','backend':'Vulkan'}
 def stop_process(self,proc,recording=False):
  if proc and proc.poll() is None:
   proc.send_signal(signal.SIGINT if recording else signal.SIGTERM)
   try:proc.wait(timeout=4)
   except sp.TimeoutExpired:proc.kill();proc.wait(timeout=2)
 def cancel(self):
  with self.lock:
   self.cancelled.set();self.stop_process(self.recorder,True);self.recorder=None;self.stop_process(self.engine)
   if self.phase=='recording':self.cleanup();self.phase='idle'
 def cleanup(self):
  if self.tmp:self.tmp.cleanup();self.tmp=None
 def toggle(self):
  with self.lock:
   now=time.monotonic()
   if now-self.last_press<.4:return 'debounced'
   self.last_press=now
   if locked():return 'Экран заблокирован.'
   if self.phase=='processing':return 'Распознаю… повторная запись пока недоступна.'
   if self.phase=='recording':
    self.stop_process(self.recorder,True);self.recorder=None;self.phase='processing';notify('Распознаю на GPU…')
    self.worker=threading.Thread(target=self.process,daemon=True);self.worker.start();return 'processing'
   target=active_window()
   if not target:return 'Не удалось определить активное окно.'
   self.cancelled.clear();self.target=target;self.tmp=tempfile.TemporaryDirectory(prefix='record-',dir=RUNTIME);self.wav=Path(self.tmp.name)/'audio.wav'
   self.recorder=sp.Popen(['pw-record','--format','s16','--rate','16000','--channels','1',str(self.wav)],stdout=sp.DEVNULL,stderr=sp.DEVNULL)
   self.started=now;self.phase='recording';notify('Запись началась · повтори Win+Ctrl+Alt+S для остановки.');return 'recording'
 def process(self):
  try:
   if self.cancelled.is_set() or locked():return
   if not audible(self.wav):notify('Запись слишком короткая или тихая.');return
   with (STATE/'engine.log').open('wb') as log:
    with self.lock:
     if self.cancelled.is_set():return
     self.engine=sp.Popen(engine_command(self.wav),stdout=sp.PIPE,stderr=log)
    try:raw,_=self.engine.communicate(timeout=180)
    except sp.TimeoutExpired:self.stop_process(self.engine);raise RuntimeError('Распознавание превысило 3 минуты.')
   if self.cancelled.is_set() or locked():return
   if self.engine.returncode:raise RuntimeError('Ошибка GPU-движка. Журнал: ~/.local/state/dictation-live/engine.log')
   result=json.loads(raw);text=result['text'].strip()
   if not text:notify('Речь не распознана.');return
   textfile=Path(self.tmp.name)/'result.txt';textfile.write_text(text)
   if self.cancelled.is_set():return
   p=sp.run([str(H/'.local/bin/dictation-paste'),'--file',str(textfile),'--target-window',self.target],capture_output=True,text=True,timeout=8,check=True)
   elapsed=result['transcribe_ms'][0]/1000
   if p.stdout.strip()=='pasted':notify(f'Вставлено · {elapsed:.1f} с · Enter не нажат.')
   elif p.stdout.strip()=='clipboard':notify('Окно изменилось · текст в буфере. Вставь вручную.')
  except Exception as error:
   if not self.cancelled.is_set():notify(str(error)[:350])
  finally:
   with self.lock:self.engine=None;self.cleanup();self.phase='idle'
 def tick(self):
  with self.lock:
   if self.phase!='idle' and locked():self.cancel()
   elif self.phase=='recording':
    if self.recorder.poll() is not None:self.recorder=None;self.cleanup();self.phase='idle';notify('Не удалось записать микрофон.')
    elif time.monotonic()-self.started>=120:self.last_press=0;self.toggle()

def daemon():
 RUNTIME.mkdir(mode=0o700,parents=True,exist_ok=True);STATE.mkdir(mode=0o700,parents=True,exist_ok=True)
 with (RUNTIME/'daemon.lock').open('w') as guard:
  fcntl.flock(guard,fcntl.LOCK_EX|fcntl.LOCK_NB)
  path=RUNTIME/'control.sock';path.unlink(missing_ok=True)
  server=socket.socket(socket.AF_UNIX);server.bind(str(path));path.chmod(0o600);server.listen(4);server.settimeout(.25)
  session=Session();quit_event=threading.Event()
  for sig in (signal.SIGTERM,signal.SIGINT):signal.signal(sig,lambda *_:quit_event.set())
  try:
   while not quit_event.is_set():
    try:
     client,_=server.accept()
     with client:
      client.settimeout(2);action=client.recv(100).decode().strip()
      if action=='toggle':response=session.toggle()
      elif action=='cancel':session.cancel();response='cancelled'
      elif action=='status':response=session.status()
      else:response='Unknown command'
      client.sendall(json.dumps(response,ensure_ascii=False).encode())
    except (socket.timeout,BrokenPipeError):pass
    session.tick()
  finally:
   session.cancel()
   if session.worker:session.worker.join(timeout=5)
   session.cleanup();server.close();path.unlink(missing_ok=True)

def client(action):
 path=RUNTIME/'control.sock'
 if action=='toggle':
  result=sp.run(['systemctl','--user','start','dictation-live.service'],capture_output=True,text=True,timeout=10)
  if result.returncode:raise RuntimeError(result.stderr.strip())
  deadline=time.monotonic()+5
  while not path.exists() and time.monotonic()<deadline:time.sleep(.05)
 with socket.socket(socket.AF_UNIX) as conn:
  conn.settimeout(12);conn.connect(str(path));conn.sendall(action.encode());response=json.loads(conn.recv(4096))
 print(json.dumps(response,ensure_ascii=False))
 if response=='cancelled':notify('Запись / распознавание отменено.')
 if isinstance(response,str) and response not in ('recording','processing','cancelled','debounced'):notify(response)

def main():
 os.umask(0o077);p=argparse.ArgumentParser(description=__doc__);p.add_argument('action',choices=['daemon','toggle','cancel','status','check-file']);p.add_argument('wav',type=Path,nargs='?');args=p.parse_args()
 if args.action=='daemon':daemon()
 elif args.action=='check-file':
  if not args.wav:p.error('check-file requires a WAV')
  raise SystemExit(sp.run(engine_command(args.wav)).returncode)
 else:client(args.action)
if __name__=='__main__':
 try:main()
 except Exception as error:
  print('Local Whisper:',error,file=sys.stderr);notify(str(error)[:350]);raise SystemExit(1)
