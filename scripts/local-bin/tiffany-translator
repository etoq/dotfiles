    def text_pane(self, parent, label, editable):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        box.pack_start(Gtk.Label(label=label, xalign=0), False, False, 0)
        view = Gtk.TextView(editable=editable, cursor_visible=editable)
        view.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
        view.set_accepts_tab(False)
        for side in ('left', 'right', 'top', 'bottom'):
            getattr(view, 'set_' + side + '_margin')(12)
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        scroll.add(view)
        box.pack_start(scroll, True, True, 0)
        parent.pack_start(box, True, True, 0)
        return view

    def provider_changed(self, *_):
        provider = self.provider.get_active_id()
        config = core.provider_config(provider)
        self.model.set_text(config['model'])
        self.secret.set_text('')
        self.project.set_text(config.get('project', ''))
        self.location.set_text(config.get('location', 'global'))
        self.credentials.set_text(config.get('credentials', ''))
        cloud = provider == 'google'
        self.cloud_reveal.set_reveal_child(cloud)
        self.secret_reveal.set_reveal_child(not cloud)
        hints = {
            'gemini': 'Модель Gemini · низкий уровень thinking для быстрого перевода.',
            'deepl': 'latency_optimized — быстрее; quality_optimized — приоритет качества.',
            'google': 'Модель general/nmt. Нужны Cloud Translation API, биллинг и права Cloud Translation API User. API-ключ Gemini не подходит.',
        }
        links = {'gemini': ('https://aistudio.google.com/apikey', 'Получить ключ Gemini'),
                 'deepl': ('https://www.deepl.com/en/developers', 'Получить ключ DeepL'),
                 'google': ('https://console.cloud.google.com/apis/library/translate.googleapis.com', 'Настроить Google Cloud')}
