#!/usr/bin/python
"""Versioned Proton backup with complete restore verification and scoped retention.
Default is local plan inspection. Timers use --scheduled with an enabled plan.
"""
import argparse,contextlib,datetime,fcntl,hashlib,json,os,re,shutil,stat,subprocess as sp,sys,tarfile,tempfile,time
from pathlib import Path,PurePosixPath
H=Path.home();STATE=H/'.local/state/workstation-backup';PLAN=H/'.config/workstation-backup/plan.json'
os.umask(0o077)
def atomic_json(path,data):
    path.parent.mkdir(parents=True,exist_ok=True)
    tmp=path.with_suffix('.tmp');tmp.write_text(json.dumps(data,ensure_ascii=False,indent=2)+'\n');tmp.replace(path)
def sha(path):
    with path.open('rb') as f:return hashlib.file_digest(f,'sha256').hexdigest()
def safe_name(name):
    p=PurePosixPath(name)
    if p.is_absolute() or '..' in p.parts or not p.parts:raise RuntimeError('Unsafe archive member')
    return str(p)
def inspect_archive(archive):
    entries={}
    proc=sp.Popen(['zstd','-dc',str(archive)],stdout=sp.PIPE,stderr=sp.DEVNULL)
    try:
        with tarfile.open(fileobj=proc.stdout,mode='r|') as tf:
            for m in tf:
                name=safe_name(m.name)
                if name in entries:raise RuntimeError('Duplicate archive member')
                item={'type':'','mode':m.mode,'size':m.size}
                if m.isfile():
                    item['type']='file'
                    with tf.extractfile(m) as f:item['sha256']=hashlib.file_digest(f,'sha256').hexdigest()
                elif m.isdir():item['type']='directory'
                elif m.issym():item.update(type='symlink',target=m.linkname)
                elif m.islnk():item.update(type='hardlink',target=safe_name(m.linkname))
                else:raise RuntimeError('Archive contains unsupported special files')
                entries[name]=item
        if proc.wait()!=0:raise RuntimeError('Could not decompress the full archive')
    finally:
        proc.stdout.close()
        if proc.poll() is None:proc.terminate();proc.wait()
    for name,item in entries.items():
        for parent in PurePosixPath(name).parents:
            if str(parent) in entries and entries[str(parent)]['type']!='directory':raise RuntimeError('Non-directory archive ancestor')
        if item['type']=='hardlink' and item['target'] not in entries:raise RuntimeError('Hardlink target outside archive')
    return entries

def restore_verify(archive,entries,dest):
    sp.run(['tar','--extract','--zstd','--file',str(archive),'--directory',str(dest),'--no-same-owner','--same-permissions','--acls','--xattrs'],check=True,stdout=sp.DEVNULL)
    verified=0
    for name,item in entries.items():
        p=dest/name;st=p.lstat();kind=item['type']
        if kind=='symlink':
            if not stat.S_ISLNK(st.st_mode) or os.readlink(p)!=item['target']:raise RuntimeError('Restored symlink differs')
        elif kind=='directory':
            if not stat.S_ISDIR(st.st_mode):raise RuntimeError('Restored directory differs')
        elif kind=='file':
            if not stat.S_ISREG(st.st_mode) or st.st_size!=item['size'] or sha(p)!=item['sha256']:raise RuntimeError('Restored file hash differs')
            verified+=1
        elif kind=='hardlink':
            target=dest/item['target']
            if not stat.S_ISREG(st.st_mode) or st.st_ino!=target.stat().st_ino:raise RuntimeError('Restored hardlink differs')
        if kind!='symlink' and stat.S_IMODE(st.st_mode)!=item['mode']:raise RuntimeError('Restored permissions differ')
    return verified

def verified_records(plan):
    """Only our locally recorded, restore-verified versions can be retired."""
    records=[];remote=plan['destination']['remote_directory'].rstrip('/')
    for folder in sorted((STATE/'runs').iterdir()):
        if not folder.is_dir() or not re.fullmatch(r'\d{8}T\d{6}Z(?:-partial)?',folder.name):continue
        try:
            result=json.loads((folder/'result.json').read_text())
            manifest=json.loads((folder/'manifest.json').read_text())
            retirement=json.loads((folder/'retention.json').read_text()) if (folder/'retention.json').exists() else {}
        except (OSError,ValueError):continue
        if retirement.get('state')=='deleted':continue
        if result.get('state')!='success' or result.get('restore_verified') is not True:continue
        if result.get('run_id')!=folder.name or result.get('remote')!=remote+'/'+folder.name:continue
        if manifest.get('created_utc')!=folder.name or manifest.get('sha256')!=result.get('archive_sha256'):continue
        if manifest.get('archive')!=result.get('archive'):continue
        scope=manifest.get('scope','partial' if folder.name.endswith('-partial') else 'full')
        records.append(dict(folder=folder,id=folder.name,result=result,manifest=manifest,retirement=retirement,scope=scope))
    return records

def retention_targets(records,plan):
    policy=plan.get('retention',{})
    full_keep=policy.get('full_versions',1);daily_keep=policy.get('keepass_daily_versions',14)
    if type(full_keep) is not int or type(daily_keep) is not int or full_keep<1 or daily_keep<1:raise RuntimeError('Retention must preserve at least one version')
    full=[r for r in records if r['scope']=='full']
    targets=[]
    if len(full)>full_keep:
        latest=full[-1]
        for old in full[:-full_keep]:
            # Do not erase the only backup of a source removed from the plan.
            if set(old['manifest']['sources'])<=set(latest['manifest']['sources']):targets.append((old,latest))
    sources=set(plan.get('keepass_sources',[]))
    if sources:
        daily=[r for r in records if r['scope']=='partial' and set(r['manifest']['sources'])==sources]
        by_day={}
        for record in daily:
            day=datetime.datetime.fromisoformat(record['result']['last_success']).date().isoformat()
            by_day[day]=record
        keep={record['id'] for _day,record in sorted(by_day.items())[-daily_keep:]}
        if daily:
            targets.extend((r,daily[-1]) for r in daily if r['id'] not in keep)
    return targets

def valid_uid(uid):
    return isinstance(uid,str) and re.fullmatch(r'[A-Za-z0-9_-]+~[A-Za-z0-9_-]+',uid) is not None

def verify_remote_record(record,plan,stage,cli,cli_json):
    remote=record['result']['remote']
    node=cli_json('filesystem','info',remote,'--json')
    expected=plan['destination']['folder_uid']
    if (not valid_uid(node.get('uid')) or node.get('parentUid')!=expected or node.get('type')!='folder'
            or node.get('name')!={'ok':True,'value':record['id']} or node.get('isShared') is not False
            or node.get('isSharedByUrl') is not False):raise RuntimeError('Unexpected backup folder identity; retention stopped')
    # Pin all subsequent operations to this UID, not a possibly reused name.
    pinned=plan['destination']['remote_directory'].rstrip('/')+'/'+node['uid']
    dest=stage/('retention-check-'+record['id']);dest.mkdir(mode=0o700,exist_ok=True)
    (dest/'manifest.json').unlink(missing_ok=True)
    cli('filesystem','download',pinned+'/manifest.json',str(dest))
    if json.loads((dest/'manifest.json').read_text())!=record['manifest']:raise RuntimeError('Remote manifest differs; retention stopped')
    return node['uid']

def prune_verified(plan,stage,cli,cli_json):
    if not plan.get('retention',{}).get('enabled'):return []
    targets=retention_targets(verified_records(plan),plan)
    anchors=set();deleted=[]
    for old,new in targets:
        if new['id'] not in anchors:
            verify_remote_record(new,plan,stage,cli,cli_json);anchors.add(new['id'])
        journal=old['folder']/'retention.json';entry=old['retirement']
        if entry.get('state') not in ('prepared','trashed'):
            uid=verify_remote_record(old,plan,stage,cli,cli_json)
            entry={'state':'prepared','uid':uid,'root_uid':plan['destination']['folder_uid'],
                   'manifest_sha256':old['manifest']['sha256'],'replacement':new['id']}
            atomic_json(journal,entry)
        uid=entry.get('uid')
        if (not valid_uid(uid) or entry.get('root_uid')!=plan['destination']['folder_uid']
                or entry.get('manifest_sha256')!=old['manifest']['sha256']):raise RuntimeError('Invalid retention journal')
        trashed=cli_json('filesystem','list','/trash','--json')
        node=next((n for n in trashed if n.get('uid')==uid),None)
        if node is None:
            active=cli_json('filesystem','list',plan['destination']['remote_directory'],'--json')
            if not any(n.get('uid')==uid for n in active):
                # A previous delete can succeed before its response/journal write.
                # The old UID is absent; never substitute a new folder by name.
                entry['state']='deleted';atomic_json(journal,entry);deleted.append(old['id']);continue
            # Recheck identity when resuming an interrupted trash operation.
            if verify_remote_record(old,plan,stage,cli,cli_json)!=uid:raise RuntimeError('Backup UID changed')
            cli('filesystem','trash',plan['destination']['remote_directory'].rstrip('/')+'/'+uid)
            entry['state']='trashed';atomic_json(journal,entry)
            node=cli_json('filesystem','info','/trash/'+uid,'--json')
        if node.get('uid')!=uid or node.get('type')!='folder':raise RuntimeError('Unexpected trash identity; permanent deletion refused')
        # Never empty the global trash. Delete only this verified retired UID.
        cli('filesystem','delete','/trash/'+uid)
        entry['state']='deleted';atomic_json(journal,entry);deleted.append(old['id'])
    return deleted

def main():
    with contextlib.ExitStack() as resources:
        return run_backup(resources)

def run_backup(resources):
    parser=argparse.ArgumentParser(description=__doc__)
    execution=parser.add_mutually_exclusive_group()
    execution.add_argument('--run-once',action='store_true')
    execution.add_argument('--scheduled',choices=['full','keepass'])
    parser.add_argument('--only',action='append',help='Back up only this exact configured source (repeatable)');args=parser.parse_args()
    if os.geteuid()==0:raise RuntimeError('Run as your normal desktop user, without sudo')
    if args.scheduled and args.only:raise RuntimeError('--only cannot be combined with --scheduled')
    if args.run_once or args.scheduled:
        STATE.mkdir(parents=True,exist_ok=True);STATE.chmod(0o700)
        lock=resources.enter_context((STATE/'backup.lock').open('a'))
        # Timers can overlap after login. Wait without reading an outdated plan.
        deadline=time.monotonic()+1800
        while True:
            try:fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB);break
            except BlockingIOError:
                if time.monotonic()>=deadline:raise RuntimeError('Another backup is still running; retry later')
                time.sleep(2)
    plan=json.loads(PLAN.read_text())
    if args.scheduled and not plan.get('enabled'):
        print('Scheduled backup is disabled in the private plan.');return
    sources=(plan.get('keepass_sources') if args.scheduled=='keepass' else args.only) or plan['sources']
    if args.scheduled=='keepass' and not plan.get('keepass_sources'):raise RuntimeError('KeePass sources are not configured')
    if args.scheduled=='keepass' and not any(name.lower().endswith('.kdbx') for name in sources):raise RuntimeError('KeePass schedule must include the password database')
    if any(name not in plan['sources'] for name in sources):raise RuntimeError('--only source is not in the configured plan')
    scope='partial' if args.only or args.scheduled=='keepass' else 'full'
    for name in sources:
        safe_name(name)
        if not (H/name).exists():raise RuntimeError('A configured source is missing: '+name)
    if not (args.run_once or args.scheduled):
        print('Local plan only. Provider:',plan['destination']['provider'])
        print('Sources:',', '.join(sources));print('Schedule:',plan.get('schedule'))
        print('Use --run-once to create, upload, download and restore-check one version.');return
    if plan['destination']['provider']!='proton-drive' or not plan['destination'].get('connected'):raise RuntimeError('Proton connection is not configured')
    if plan.get('encryption')!='Proton Drive client-side end-to-end encryption':raise RuntimeError('Expected official Proton client encryption')
    for command in ['tar','zstd']:
        if not shutil.which(command):raise RuntimeError('Missing dependency: '+command)
    status=STATE/'status.json'
    previous=json.loads(status.read_text()) if status.exists() else {}
    run_id=datetime.datetime.now(datetime.timezone.utc).strftime('%Y%m%dT%H%M%SZ')+('-partial' if scope=='partial' else '')
    record=STATE/'runs'/run_id;record.mkdir(parents=True,mode=0o700)
    client=str(H/'.local/bin/proton-drive');log=resources.enter_context((record/'client.log').open('a'))
    last=previous.get('last_success');remote=plan['destination']['remote_directory'].rstrip('/')
    history={'last_success':last,
             'last_full_success':plan.get('last_full_success',previous.get('last_full_success')),
             'last_verified_remote':plan.get('last_verified_remote',previous.get('remote')),
             'last_full_verified_remote':plan.get('last_full_verified_remote',previous.get('last_full_verified_remote'))}
    if not remote.startswith('/my-files/') or '..' in PurePosixPath(remote).parts:raise RuntimeError('Unsafe destination')
    temp_root=H/'.local/share/workstation-backup/staging';temp_root.mkdir(parents=True,exist_ok=True);temp_root.chmod(0o700)
    stage=Path(tempfile.mkdtemp(prefix=run_id+'-',dir=temp_root))
    uploaded=False
    def phase(name,message):
        atomic_json(status,dict(history,state='running',phase=name,scope=scope,message=message,run_id=run_id))
        print(name+': '+message,flush=True)
    def cli(*args,check=True):
        p=sp.run([client,*args],stdout=log,stderr=log,text=True)
        log.flush()
        if check and p.returncode:raise RuntimeError('Proton command failed; private log: '+str(record/'client.log'))
        return p.returncode
    def cli_json(*args):
        p=sp.run([client,*args],stdout=sp.PIPE,stderr=log,text=True,timeout=120)
        log.flush()
        if p.returncode:raise RuntimeError('Proton metadata request failed; private log: '+str(record/'client.log'))
        return json.loads(p.stdout)
    try:
        phase('connection','Проверка доступа к Proton Drive')
        cli('filesystem','info','/my-files','--json')
        if cli('filesystem','info',remote,'--json',check=False):
            parent,name=remote.rsplit('/',1);cli('filesystem','create-folder',parent,name)
        if plan.get('retention',{}).get('enabled'):
            node=cli_json('filesystem','info',remote,'--json')
            if not valid_uid(node.get('uid')) or node.get('type')!='folder' or node.get('isShared') is not False or node.get('isSharedByUrl') is not False:raise RuntimeError('Unexpected backup root identity')
            if plan['destination'].get('folder_uid',node['uid'])!=node['uid']:raise RuntimeError('Backup root UID changed; retention stopped')
            plan['destination']['folder_uid']=node['uid'];atomic_json(PLAN,plan)
            phase('retention','Повтор незавершённой очистки только проверенных старых версий')
            prune_verified(plan,stage,cli,cli_json)
        phase('archive','Создание локального архива выбранных папок')
        archive=stage/('zer0-'+run_id+'.tar.zst')
        for attempt in range(3):
            cmd=['tar','--create','--file',str(archive),'--directory',str(H),'--acls','--xattrs','--sparse','--use-compress-program=zstd -T2 -3']
            cmd += ['--exclude='+pattern for pattern in plan.get('exclude',[])]
            cmd += ['--',*sources]
            p=sp.run(cmd,stdout=sp.DEVNULL,stderr=sp.PIPE,text=True)
            (record/'archive.log').write_text(p.stderr)
            if p.returncode==0:break
            if p.returncode!=1 or attempt==2:raise RuntimeError('Source files changed or tar failed; archive was not uploaded. See '+str(record/'archive.log'))
            time.sleep(2)
        archive.chmod(0o600)
        policy=plan.get('storage',{})
        if policy.get('max_archive_bytes') and archive.stat().st_size>policy['max_archive_bytes']:raise RuntimeError('Archive exceeds the configured size limit; previous cloud backup preserved')
        phase('manifest','Хеширование файлов из готового архива')
        entries=inspect_archive(archive);digest=sha(archive)
        manifest=stage/'manifest.json'
        data={'created_utc':run_id,'archive':archive.name,'sha256':digest,'bytes':archive.stat().st_size,'sources':sources,'scope':scope,'exclude':plan.get('exclude',[]),'entries':entries,'encryption':'Proton Drive client-side E2EE','consistency':'File-level archive of live user data; not an application-consistent database or VM snapshot.'}
        atomic_json(manifest,data);shutil.copyfile(manifest,record/'manifest.json')
        (stage/'SHA256SUMS').write_text(digest+'  '+archive.name+'\n')
        # All archive names and symlink ancestors were validated before upload/extraction.
        phase('upload',f'Загрузка версии {run_id} ({archive.stat().st_size//1024**2} МиБ)')
        if policy.get('budget_bytes'):
            used=cli_json('filesystem','size','/my-files','--json').get('size')
            if type(used) is not int or used<0:raise RuntimeError('Could not establish cloud storage usage')
            payload=sum(p.stat().st_size for p in [archive,manifest,stage/'SHA256SUMS'])
            if used+payload+policy.get('reserve_bytes',0)>policy['budget_bytes']:raise RuntimeError('Not enough budget for a verified replacement; previous backup preserved')
        run_remote=remote+'/'+run_id
        cli('filesystem','create-folder',remote,run_id)
        cli('filesystem','upload','--skip-thumbnails','--file-conflict-strategy','skip',str(archive),str(manifest),str(stage/'SHA256SUMS'),run_remote)
        uploaded=True
        phase('download','Скачивание созданной копии обратно для проверки')
        download=stage/'download';download.mkdir(mode=0o700)
        cli('filesystem','download',run_remote+'/'+archive.name,run_remote+'/manifest.json',run_remote+'/SHA256SUMS',str(download))
        returned=download/archive.name
        if not returned.is_file() or sha(returned)!=digest:raise RuntimeError('Downloaded archive hash mismatch')
        if json.loads((download/'manifest.json').read_text())!=data:raise RuntimeError('Downloaded manifest differs')
        if (download/'SHA256SUMS').read_bytes()!=(stage/'SHA256SUMS').read_bytes():raise RuntimeError('Downloaded checksum file differs')
        phase('restore','Пробное восстановление всех файлов в отдельную папку')
        restored=stage/'restore';restored.mkdir(mode=0o700)
        count=restore_verify(returned,entries,restored)
        finished=datetime.datetime.now().astimezone().isoformat()
        result={'state':'success','run_id':run_id,'last_success':finished,'remote':run_remote,'archive':archive.name,'archive_bytes':archive.stat().st_size,'archive_sha256':digest,'verified_files':count,'verified_entries':len(entries),'restore_verified':True,'scope':scope,'sources':sources,'last_full_success':history['last_full_success'] if scope=='partial' else finished,'last_verified_remote':run_remote,'last_full_verified_remote':history['last_full_verified_remote'] if scope=='partial' else run_remote,'message':f'Proton: {"дополнение" if scope=="partial" else "полная копия"} и восстановление проверены, файлов {count}.'}
        atomic_json(record/'result.json',result);atomic_json(status,result)
        plan['last_success']=finished;plan['last_verified_remote']=run_remote
        if scope=='full':plan['last_full_success']=finished;plan['last_full_verified_remote']=run_remote
        plan['note']='Uploaded, downloaded and restore-verified. Full copies and standalone KeePass supplements have separate retention.';atomic_json(PLAN,plan)
        history={k:result.get(k) for k in history}
        phase('retention','Удаление только устаревших версий после проверки восстановления новой')
        result['retired_versions']=prune_verified(plan,stage,cli,cli_json)
        atomic_json(record/'result.json',result);atomic_json(status,result)
        print('SUCCESS:',run_remote,flush=True);print('SHA256:',digest,flush=True);print('Restored and verified files:',count,flush=True)
    except BaseException as e:
        atomic_json(status,dict(history,state='error',scope=scope,run_id=run_id,uploaded=uploaded,message=str(e)))
        raise
    finally:
        log.close();shutil.rmtree(stage)
if __name__=='__main__':
    try:main()
    except (Exception,KeyboardInterrupt) as e:print('Backup failed:',e,file=sys.stderr);sys.exit(1)
