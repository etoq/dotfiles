#!/usr/bin/env python3
"""Recover Wispr when its helper stalls or disappears, with a restart cooldown.

Only process metadata and broker accounting are read. No accessibility text or clipboard is queried.
"""
import argparse
import json
import os
from pathlib import Path
import subprocess
import time

LIMIT = 32 * 1024 * 1024
HELPERS = {
    "/opt/wispr-flow-appimage/usr/lib/wispr-flow/resources/Release/wispr-flow-linux-helper",
    "/usr/lib/wispr-flow/resources/Release/wispr-flow-linux-helper",
}


def helper_identity(pid):
    """Verify ownership, packaged executable and the parent; reject reused PIDs."""
    proc = Path('/proc') / str(pid)
    try:
        if proc.stat().st_uid != os.getuid() or str((proc / 'exe').resolve()) not in HELPERS:
            return None
        fields = (proc / 'stat').read_text().rsplit(')', 1)[1].split()
        parent = Path('/proc') / fields[1]
        if parent.stat().st_uid != os.getuid() or (parent / 'comm').read_text().strip() != 'wispr-flow':
            return None
        return fields[19]  # starttime, field 22 in /proc/PID/stat
    except (OSError, IndexError):
        return None


def queued_helpers(stats):
    peers = stats['data'][0]['org.bus1.DBus.Debug.Stats.PeerAccounting']['data']
    result = {}
    for _name, properties, counters in peers:
        if properties['UnixUserID']['data'] != os.getuid():
            continue
        queued = counters['OutgoingBytes']
        if queued < LIMIT:
            continue
        pid = properties['ProcessID']['data']
        identity = helper_identity(pid)
        if identity is not None:
            result[str(pid)] = {'start': identity, 'bytes': queued}
    return result


APP_EXES = {
    '/opt/wispr-flow-appimage/usr/lib/wispr-flow/wispr-flow',
    '/usr/lib/wispr-flow/wispr-flow',
}


def is_main_args(args):
    # Electron can flatten its full process title into argv[0].
    return b'--type=' not in b' '.join(args)


def app_processes():
    result = {}
    for proc in Path('/proc').iterdir():
        if not proc.name.isdigit():
            continue
        try:
            exe = str((proc / 'exe').resolve())
            args = (proc / 'cmdline').read_bytes().split(b'\0')
            if proc.stat().st_uid != os.getuid() or exe not in APP_EXES:
                continue
            if not is_main_args(args):
                continue
            fields = (proc / 'stat').read_text().rsplit(')', 1)[1].split()
            if fields[0] == 'Z':
                continue
            parent = Path('/proc') / fields[1]
            if str((parent / 'exe').resolve()) in APP_EXES:
                continue
            result[int(proc.name)] = (exe, fields[19])
        except (OSError, IndexError):
            continue
    return result


def restart_app(pid, identity):
    # Never signal arbitrary Electron processes, even if they share the executable.
    # Only systemd may recover the verified main PID and its service cgroup.
    if (Path(os.environ.get('XDG_RUNTIME_DIR', f'/run/user/{os.getuid()}')) / 'wispr-screen-lock.json').exists():
        return False
    if app_processes().get(pid) != identity:
        return False
    managed = subprocess.run(['systemctl', '--user', 'show', 'wispr-flow.service',
                              '-p', 'MainPID', '--value'], capture_output=True, text=True, timeout=5)
    if managed.returncode or managed.stdout.strip() != str(pid):
        return False
    if app_processes().get(pid) != identity:
        return False
    result = subprocess.run(['systemctl', '--user', 'restart', 'wispr-flow.service'],
                            capture_output=True, timeout=20)
    return result.returncode == 0


def app_health(candidates, runtime, execute):
    """Recover an absent helper after 90 seconds or a repeatedly stuck queue.

    Maximum two recoveries per hour, at least 30 minutes apart. No popup,
    no launch if the user closed Flow, no clipboard/dictation text access.
    """
    path = runtime / 'wispr-app-health.json'
    try:
        old = json.loads(path.read_text())
    except (OSError, ValueError):
        old = {}
    now = time.monotonic()
    restarts = [t for t in old.get('restarts', []) if 0 <= now-t < 3600]
    apps = app_processes()
    states = {}
    live_helpers = set()
    for proc in Path('/proc').iterdir():
        if proc.name.isdigit() and helper_identity(int(proc.name)) is not None:
            try:
                fields = (proc / 'stat').read_text().rsplit(')', 1)[1].split()
                live_helpers.add(int(fields[1]))
            except (OSError, IndexError, ValueError):
                pass
    for pid, identity in apps.items():
        key = str(pid) + ':' + identity[1]
        previous = old.get('apps', {}).get(key, {})
        missing_since = previous.get('missing_since', now) if pid not in live_helpers else now
        queued = False
        for helper in candidates:
            if helper_identity(int(helper)) is None:
                continue
            try:
                parent = int((Path('/proc') / helper / 'stat').read_text().rsplit(')', 1)[1].split()[1])
                queued = queued or parent == pid
            except (OSError, IndexError, ValueError):
                pass
        repeated = queued and previous.get('queued', False)
        reason = 'stalled AT-SPI queue' if repeated else 'helper absent for 90 seconds'
        unhealthy = repeated or (pid not in live_helpers and now-missing_since >= 90)
        states[key] = {'missing_since': missing_since, 'queued': queued}
        if execute and unhealthy and len(restarts) < 2 and (not restarts or now-restarts[-1] >= 1800):
            if restart_app(pid, identity):
                restarts.append(now)
                print(f'Restarted Wispr PID {pid}: {reason}', flush=True)
    temp = path.with_suffix('.tmp')
    temp.write_text(json.dumps({'apps': states, 'restarts': restarts}))
    temp.chmod(0o600)
    temp.replace(path)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--run', action='store_true', help='recover after two consecutive large-queue observations')
    args = parser.parse_args()
    runtime = Path(os.environ.get('XDG_RUNTIME_DIR', f'/run/user/{os.getuid()}'))
    if (runtime / 'wispr-screen-lock.json').exists():
        return
    # Do not start an accessibility bus just for monitoring.
    if not (runtime / 'at-spi/bus_0').exists():
        if args.run:
            app_health({}, runtime, True)
        return
    address = 'unix:path=' + str(runtime / 'at-spi/bus_0')
    response = subprocess.run([
        'busctl', '--address=' + address, '--json=short', 'call',
        'org.freedesktop.DBus', '/org/freedesktop/DBus',
        'org.freedesktop.DBus.Debug.Stats', 'GetStats',
    ], capture_output=True, text=True, timeout=5, check=True)
    candidates = queued_helpers(json.loads(response.stdout))
    if not args.run:
        print(json.dumps({'threshold_bytes': LIMIT, 'stalled_helpers': candidates}))
        return
    app_health(candidates, runtime, True)



if __name__ == '__main__':
    main()
