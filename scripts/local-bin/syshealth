#!/bin/bash
# ~/.local/bin/syshealth
export LC_ALL=C
echo "  SYSTEM HEALTH — $(hostname)"
echo " ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""
echo "  CPU"
cpu=$(LC_ALL=C top -bn1 | awk '/Cpu\(s\)/ {printf "%.0f", 100-$8; found=1; exit} END {if (!found) printf "?"}')
echo "  Load:  ${cpu}%"
t=0
for sensor in /sys/class/hwmon/hwmon*; do
  if [ "$(cat "$sensor/name" 2>/dev/null)" = coretemp ]; then
    t=$(cat "$sensor/temp1_input" 2>/dev/null || echo 0)
    break
  fi
done
echo "  Temp:  $((t/1000))°C"
echo ""
echo "  MEMORY"
free -h | grep Mem | awk '{print "  Used: " $3 " / " $2}'
echo ""
echo "  DISK"
df -h / | tail -1 | awk '{print "  Root: " $3 " / " $2 " (" $5 " used)"}'
df -h /vms 2>/dev/null | tail -1 | awk '{print "  VMs:  " $3 " / " $2 " (" $5 " used)"}'
echo ""
echo "  NETWORK"
ip -4 addr show | grep inet | grep -v 127 | awk '{print "  " $2}'
echo ""
echo "  SERVICES"
for svc in NetworkManager virtqemud virtnetworkd apparmor thinkfan bluetooth; do
  st=$(systemctl is-active $svc 2>/dev/null)
  [ "$st" = "active" ] && ic=" " || ic=" "
  echo "  $ic $svc: $st"
done
echo ""
echo " ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
read -p "  Press Enter to close..."
