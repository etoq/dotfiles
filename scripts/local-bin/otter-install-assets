#!/usr/bin/env python3
"""Install pinned official OCR models and offline CyberChef, without root."""
import hashlib
import os
from pathlib import Path
import shutil
import tempfile
import urllib.request
import zipfile

ROOT = Path.home() / '.local/share/otter-tools'
MODELS = {
    'eng': '7d4322bd2a7749724879683fc3912cb542f19906c83bcc1a52132556427170b2',
    'rus': 'e16e5e036cce1d9ec2b00063cf8b54472625b9e14d893a169e2b0dedeb4df225',
}
CHEF_URL = 'https://github.com/gchq/CyberChef/releases/download/v11.5.0/CyberChef_8cd426dd4f40f1423912d5fad91b578a86a65112.zip'
CHEF_SHA = 'f6478925d3eaa16ec08626a85f5b85eed10d531a5e18700615fed7ecb024cccf'


def digest(path):
    with path.open('rb') as stream:
        return hashlib.file_digest(stream, 'sha256').hexdigest()


def download(url, path, sha):
    path.parent.mkdir(parents=True, exist_ok=True)
    if path.is_file() and digest(path) == sha:
        return
    partial = path.with_suffix(path.suffix + '.part')
    try:
        print('Загрузка:', url, flush=True)
        request = urllib.request.Request(url, headers={'User-Agent': 'Black-Tiffany-dotfiles'})
        with urllib.request.urlopen(request, timeout=30) as source, partial.open('wb') as target:
            shutil.copyfileobj(source, target)
        if digest(partial) != sha:
            raise ValueError('Контрольная сумма не совпала: ' + url)
        partial.replace(path)
    finally:
        partial.unlink(missing_ok=True)


def install_chef(archive):
    if digest(archive) != CHEF_SHA:
        raise ValueError('Неверная контрольная сумма CyberChef')
    ROOT.mkdir(parents=True, exist_ok=True)
    target = ROOT / 'cyberchef'
    if target.exists():
        raise ValueError('Папка CyberChef уже существует; автоматическая перезапись отключена')
    with tempfile.TemporaryDirectory(dir=ROOT, prefix='chef-install-') as temp:
        staging = Path(temp) / 'cyberchef'
        staging.mkdir()
        with zipfile.ZipFile(archive) as z:
            for entry in z.infolist():
                path = staging / entry.filename
                if not path.resolve().is_relative_to(staging.resolve()):
                    raise ValueError('Недопустимый путь в архиве')
                if entry.is_dir():
                    path.mkdir(parents=True, exist_ok=True)
                else:
                    path.parent.mkdir(parents=True, exist_ok=True)
                    with z.open(entry) as source, path.open('wb') as dest:
                        shutil.copyfileobj(source, dest)
        if not list(staging.glob('CyberChef*.html')):
            raise ValueError('В архиве отсутствует CyberChef HTML')
        (staging / '.version').write_text('v11.5.0\n' + CHEF_SHA + '\n')
        staging.rename(target)


def main():
    os.umask(0o077)
    for lang, sha in MODELS.items():
        download('https://raw.githubusercontent.com/tesseract-ocr/tessdata_fast/4.1.0/' + lang + '.traineddata',
                 ROOT / 'tessdata' / (lang + '.traineddata'), sha)
    version = ROOT / 'cyberchef/.version'
    if not version.is_file() or CHEF_SHA not in version.read_text():
        with tempfile.TemporaryDirectory(prefix='otter-download-') as temp:
            archive = Path(temp) / 'chef.zip'
            download(CHEF_URL, archive, CHEF_SHA)
            install_chef(archive)
    print('OK: OCR rus+eng и CyberChef v11.5.0')


if __name__ == '__main__':
    main()
