#!/usr/bin/env python3
"""Private OAuth helper, called over pipes by translate. No credentials in argv/logs."""
import json
import os
from pathlib import Path
import sys


def main():
    import google.auth
    from google.auth.transport.requests import Request
    import requests
    config = json.load(sys.stdin)
    scopes = ['https://www.googleapis.com/auth/cloud-translation']
    path = Path(config.get('credentials') or os.environ.get('GOOGLE_APPLICATION_CREDENTIALS')
                or Path.home() / '.config/gcloud/application_default_credentials.json').expanduser()
    info = json.loads(path.read_text())
    # Only local account credentials; never contact an endpoint supplied by an arbitrary JSON.
    if info.get('type') not in ('service_account', 'authorized_user'):
        raise ValueError('unsupported credentials')
    if info.get('type') == 'service_account' and info.get('token_uri') != 'https://oauth2.googleapis.com/token':
        raise ValueError('unsupported token endpoint')
    credentials, _ = google.auth.load_credentials_from_dict(info, scopes=scopes)
    class Session(requests.Session):
        def request(self, method, url, **kwargs):
            if url != 'https://oauth2.googleapis.com/token':
                raise ValueError('unexpected auth endpoint')
            kwargs['allow_redirects'] = False
            kwargs['timeout'] = 18
            return super().request(method, url, **kwargs)
    with Session() as session:
        credentials.refresh(Request(session=session))
    print(json.dumps({'token': credentials.token}))


if __name__ == '__main__':
    try:
        main()
    except Exception:
        # Never expose response bodies, refresh tokens, client secrets or private keys.
        print('Не удалось авторизоваться в Google Cloud. Проверьте JSON, доступ к проекту и сеть.')
        sys.exit(1)
