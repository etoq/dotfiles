#!/usr/bin/env bash
# Remove image metadata only from the explicitly selected existing path.
set -u
target=${1:-.}
if [[ ! -e "$target" ]]; then printf 'Path does not exist: %s\n' "$target" >&2; exit 1; fi
command -v exiftool >/dev/null || { echo 'Install perl-image-exiftool.' >&2; exit 1; }
count=0; failed=0
while IFS= read -r -d '' file; do
    if exiftool -all= -overwrite_original "$file"; then ((count+=1)); else ((failed+=1)); fi
done < <(find "$target" -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.gif' -o -iname '*.webp' -o -iname '*.tif' -o -iname '*.tiff' \) -print0)
printf 'Cleaned: %d; failed: %d\n' "$count" "$failed"
(( failed == 0 ))
