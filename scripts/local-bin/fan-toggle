#!/usr/bin/python
"""Toggle existing Thinkfan profiles, reload with confirmation, notify the user."""
import argparse
import datetime as dt
import fcntl
import json
import os
from pathlib import Path
import stat
import subprocess as sp
import sys
import tempfile
import time
import yaml

CONFIG = Path('/etc/thinkfan.conf')
PROFILES = {name: Path('/etc') / f'thinkfan-{name}.conf' for name in ('normal', 'silent')}
LABELS = {'normal': 'Обычный', 'silent': 'Тихий'}
LOCK = Path('/run/thinkfan-profile-toggle.lock')
BACKUP_ROOT = Path('/var/backups')


def command(argv, timeout=10):
    result = sp.run(argv, capture_output=True, text=True, timeout=timeout)
    if result.returncode:
        raise RuntimeError(result.stderr.strip() or 'Не выполнено: ' + ' '.join(argv))
    return result.stdout.strip()


def read_profiles():
    parsed = {name: yaml.safe_load(path.read_text()) for name, path in PROFILES.items()}
    current = yaml.safe_load(CONFIG.read_text())
    matches = [name for name, data in parsed.items() if data == current]
    if len(matches) != 1:
        raise RuntimeError('Текущий конфиг не совпадает ровно с одним профилем; ничего не меняю.')
    for name, data in parsed.items():
        if not isinstance(data, dict) or set(data) != {'sensors', 'fans', 'levels'}:
            raise RuntimeError('Неизвестная структура профиля: ' + name)
        levels = data['levels']
        if not levels or any(not isinstance(row, list) or len(row) != 3 or
                             any(type(n) is not int for n in row) or
                             row[0] not in (*range(8), 127) or row[1] >= row[2] for row in levels):
            raise RuntimeError('Некорректные уровни: ' + name)
        if any(not (a[0] < b[0] and a[1] < b[1] < a[2] < b[2]) for a, b in zip(levels, levels[1:])):
            raise RuntimeError('Нарушены пороги или гистерезис: ' + name)
        if levels[0][0] != 0 or levels[-1][0] != 127 or levels[-1][2] < 120:
            raise RuntimeError('Неожиданная граница температур: ' + name)
    if parsed['normal']['sensors'] != parsed['silent']['sensors'] or parsed['normal']['fans'] != parsed['silent']['fans']:
        raise RuntimeError('Профили управляют разными датчиками/вентиляторами; ничего не меняю.')
    return matches[0], parsed


def check_sensors(data):
    for sensor in data['sensors']:
        if set(sensor) - {'hwmon', 'name', 'indices', 'max_errors'} or not {'hwmon', 'name', 'indices'} <= set(sensor) or sensor['hwmon'] != '/sys/class/hwmon':
            raise RuntimeError('Неизвестный тип датчика.')
        candidates = [p for p in Path(sensor['hwmon']).glob('hwmon*')
                      if (p / 'name').read_text().strip() == sensor['name']]
        if len(candidates) != 1:
            raise RuntimeError('Датчик недоступен: ' + sensor['name'])
        for index in sensor['indices']:
            int((candidates[0] / f'temp{index}_input').read_text())
    if data['fans'] != [{'tpacpi': '/proc/acpi/ibm/fan'}]:
        raise RuntimeError('Неизвестный интерфейс вентилятора.')
    if 'status:' not in Path('/proc/acpi/ibm/fan').read_text():
        raise RuntimeError('Интерфейс вентилятора недоступен.')


def service_pid():
    data = command(['/usr/bin/systemctl', 'show', 'thinkfan.service',
                    '-p', 'ActiveState', '-p', 'MainPID'])
    properties = dict(line.split('=', 1) for line in data.splitlines() if '=' in line)
    if properties.get('ActiveState') != 'active' or int(properties.get('MainPID', '0')) <= 0:
        raise RuntimeError('Thinkfan не запущен; профиль не переключён.')
    return int(properties['MainPID'])


def cursor():
    data = command(['/usr/bin/journalctl', '-u', 'thinkfan.service', '-n', '1', '-o', 'json', '--no-pager'])
    if not data:
        raise RuntimeError('Нет журнала Thinkfan для подтверждения переключения.')
    return json.loads(data.splitlines()[-1])['__CURSOR']


def confirmed_reload(pid):
    start = cursor()
    command(['/usr/bin/systemctl', 'reload', 'thinkfan.service'])
    deadline = time.monotonic() + 8
    while time.monotonic() < deadline:
        if service_pid() != pid:
            raise RuntimeError('Процесс Thinkfan сменился во время перечитывания.')
        output = command(['/usr/bin/journalctl', '-u', 'thinkfan.service', '--after-cursor=' + start,
                          '-o', 'json', '--no-pager'])
        seen_reload = False
        for line in output.splitlines():
            entry = json.loads(line)
            if str(entry.get('_PID', '')) != str(pid):
                continue
            message = entry.get('MESSAGE', '')
            if 'Received SIGHUP: reloading config' in message:
                seen_reload = True
            elif seen_reload:
                if any(word in message.casefold() for word in ('error', 'failed', 'keeping old')):
                    raise RuntimeError('Thinkfan отклонил конфиг: ' + message)
                if 'Temperatures' in message and '-> Fans:' in message:
                    return
        time.sleep(.2)
    raise RuntimeError('Thinkfan не подтвердил применение конфига в журнале.')


def atomic_write(data, metadata):
    fd, name = tempfile.mkstemp(prefix='.thinkfan-profile-', dir=CONFIG.parent)
    try:
        with os.fdopen(fd, 'wb') as output:
            os.fchmod(output.fileno(), stat.S_IMODE(metadata.st_mode))
            os.fchown(output.fileno(), metadata.st_uid, metadata.st_gid)
            output.write(data)
            output.flush()
            os.fsync(output.fileno())
        os.replace(name, CONFIG)
    finally:
        if os.path.exists(name):
            os.unlink(name)


def verify_root_file(path):
    metadata = path.lstat()
    if not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != 0 or metadata.st_mode & 0o022:
        raise RuntimeError('Конфиг должен быть обычным файлом root без права записи для остальных: ' + str(path))


def apply():
    if os.geteuid() != 0:
        raise RuntimeError('Внутренний шаг требует прав администратора.')
    fd = os.open(LOCK, os.O_CREAT | os.O_WRONLY | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, 'w') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise RuntimeError('Переключение уже выполняется.') from None
        for path in [CONFIG, *PROFILES.values()]:
            verify_root_file(path)
        old, profiles = read_profiles()
        target = 'silent' if old == 'normal' else 'normal'
        check_sensors(profiles[target])
        pid = service_pid()
        cursor()  # Verify journal access before modifying anything.
        original, metadata = CONFIG.read_bytes(), CONFIG.stat()
        replacement = PROFILES[target].read_bytes()
        backup = Path(tempfile.mkdtemp(prefix='thinkfan-profile-' + dt.datetime.now().strftime('%Y%m%d-%H%M%S') + '-',
                                      dir=BACKUP_ROOT))
        (backup / 'thinkfan.conf').write_bytes(original)
        try:
            atomic_write(replacement, metadata)
            confirmed_reload(pid)
        except Exception as error:
            atomic_write(original, metadata)
            try:
                confirmed_reload(pid)
                detail = 'Прежний профиль восстановлен и подтверждён.'
            except Exception as rollback_error:
                detail = 'Файл прежнего профиля восстановлен, но перечитывание не подтверждено: ' + str(rollback_error)
            raise RuntimeError(str(error) + '\n' + detail + '\nКопия: ' + str(backup)) from error
        return {'previous': old, 'mode': target, 'backup': str(backup)}


def elevated():
    script = str(Path(__file__).resolve())
    agent = None
    try:
        if sys.stdin.isatty():
            result = sp.run(['/usr/bin/sudo', '--', '/usr/bin/python', script, '--apply'],
                            text=True, stdout=sp.PIPE)
        else:
            agent_path = Path('/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1')
            if agent_path.is_file():
                agent = sp.Popen([str(agent_path)], stdout=sp.DEVNULL, stderr=sp.DEVNULL)
                time.sleep(.5)
            result = sp.run(['/usr/bin/pkexec', '--disable-internal-agent', '/usr/bin/python', script, '--apply'],
                            text=True, capture_output=True, timeout=180)
        if result.returncode:
            raise RuntimeError((getattr(result, 'stderr', None) or '').strip() or 'Переключение отменено или завершилось ошибкой.')
        return json.loads(result.stdout)
    finally:
        if agent is not None and agent.poll() is None:
            agent.terminate()
            agent.wait(timeout=5)


def notify(text, error=False):
    if os.geteuid() != 0 and (os.environ.get('DBUS_SESSION_BUS_ADDRESS') or os.environ.get('DISPLAY')):
        try:
            sp.run(['/usr/bin/notify-send', '--app-name=Thinkfan', '-u', 'normal' if error else 'low',
                    'Thinkfan · ошибка' if error else 'Thinkfan', text], timeout=5, check=False)
        except (OSError, sp.TimeoutExpired):
            pass


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    group = parser.add_mutually_exclusive_group()
    group.add_argument('--status', action='store_true', help='Показать текущий профиль без изменений')
    group.add_argument('--apply', action='store_true', help=argparse.SUPPRESS)
    args = parser.parse_args()
    if args.status:
        name, _ = read_profiles()
        print('Thinkfan: ' + LABELS[name])
        return
    if args.apply or os.geteuid() == 0:
        print(json.dumps(apply(), ensure_ascii=False))
        return
    result = elevated()
    message = 'Режим: ' + LABELS[result['mode']] + ' (был: ' + LABELS[result['previous']] + ')'
    print(message)
    notify(message)


if __name__ == '__main__':
    try:
        main()
    except (OSError, RuntimeError, ValueError, KeyError, TypeError, sp.TimeoutExpired, yaml.YAMLError) as error:
        print('Thinkfan: ' + str(error), file=sys.stderr)
        notify(str(error), error=True)
        raise SystemExit(1)
