#!/usr/bin/env python3
"""Explicit entry points for the local comparison; no login autostart."""
from pathlib import Path
import subprocess as sp
import sys,time
H=Path.home();action=sys.argv[1] if len(sys.argv)>1 else 'compare'
if action=='compare':
 sp.Popen([str(H/'.local/bin/dictation-compare')],stdin=sp.DEVNULL,stdout=sp.DEVNULL,stderr=sp.DEVNULL,start_new_session=True)
elif action=='handy':
 sp.Popen([str(H/'.local/bin/handy')],stdin=sp.DEVNULL,stdout=sp.DEVNULL,stderr=sp.DEVNULL,start_new_session=True)
elif action=='handy-toggle':
 sp.Popen([str(H/'.local/bin/handy'),'--start-hidden','--toggle-transcription'],stdin=sp.DEVNULL,stdout=sp.DEVNULL,stderr=sp.DEVNULL,start_new_session=True)
elif action=='hypr-toggle':
 start=sp.run(['systemctl','--user','start','hyprwhspr.service'],capture_output=True,text=True)
 if start.returncode:raise SystemExit(start.stderr.strip())
 path=Path('/run/user')/str(__import__('os').getuid())/'hyprwhspr/hyprwhspr.sock'
 deadline=time.monotonic()+30
 while not path.exists() and time.monotonic()<deadline:time.sleep(.1)
 result=sp.run([str(H/'.local/bin/hyprwhspr'),'record','toggle'],capture_output=True,text=True)
 if result.returncode:sp.run(['notify-send','hyprwhspr',result.stderr.strip()[:300] or 'Не удалось начать запись.'])
elif action=='hypr-stop':sp.run(['systemctl','--user','stop','hyprwhspr.service'],check=True)
else:raise SystemExit('Unknown action')
