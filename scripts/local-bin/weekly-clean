#!/usr/bin/python
"""Manual Arch maintenance with age-limited AyuGram downloads and trash cleanup."""
import argparse
import configparser
import contextlib
import datetime as dt
import fcntl
import json
import os
from pathlib import Path
import shutil
import stat
import subprocess as sp
import sys
import time

DAY = 86400
HOME = Path.home()
STATE = HOME / '.local/state/weekly-clean'


def human(n):
    return f'{n / 1024**2:.1f} МиБ'


def month_due(last, now=None):
    return last is None or (now if now is not None else time.time()) - last >= 30 * DAY


def old_files(root, days, apply=False):
    """Only old regular files; descriptor-relative traversal never follows symlinks."""
    if not root.is_dir() or root.is_symlink() or root.resolve() != root.absolute():
        return 0, 0
    cutoff = time.time() - days * DAY
    count = size = 0
    for _, dirs, files, fd in os.fwalk(root, follow_symlinks=False):
        dirs[:] = [d for d in dirs if not stat.S_ISLNK(os.stat(d, dir_fd=fd, follow_symlinks=False).st_mode)]
        for name in files:
            try:
                st = os.stat(name, dir_fd=fd, follow_symlinks=False)
                if not stat.S_ISREG(st.st_mode) or max(st.st_mtime, st.st_atime) >= cutoff:
                    continue
                if st.st_uid != os.geteuid() or st.st_nlink != 1:
                    continue
                if apply:
                    os.unlink(name, dir_fd=fd)
                count += 1
                size += st.st_size
            except FileNotFoundError:
                continue
    return count, size


def trash_roots():
    return [HOME / '.local/share/Trash', Path('/vms') / f'.Trash-{os.geteuid()}']


def old_trash(root, days=30, apply=False):
    """Use freedesktop DeletionDate, never the original file's modification date."""
    if not root.is_dir() or root.is_symlink() or root.resolve() != root.absolute():
        return 0, 0
    if root.stat().st_uid != os.geteuid():
        return 0, 0
    flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
    count = skipped = 0
    cutoff = time.time() - days * DAY
    with contextlib.ExitStack() as stack:
        root_fd = os.open(root, flags)
        stack.callback(os.close, root_fd)
        try:
            info_fd = os.open('info', flags, dir_fd=root_fd)
            stack.callback(os.close, info_fd)
            files_fd = os.open('files', flags, dir_fd=root_fd)
            stack.callback(os.close, files_fd)
        except FileNotFoundError:
            return 0, 0
        for info_name in os.listdir(info_fd):
            if not info_name.endswith('.trashinfo'):
                continue
            name = info_name[:-10]
            if not name or name in ('.', '..'):
                skipped += 1
                continue
            try:
                meta_fd = os.open(info_name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=info_fd)
                with os.fdopen(meta_fd, encoding='utf-8') as metadata:
                    st = os.fstat(metadata.fileno())
                    if not stat.S_ISREG(st.st_mode) or st.st_uid != os.geteuid() or st.st_size > 65536:
                        skipped += 1
                        continue
                    parser = configparser.ConfigParser(interpolation=None)
                    parser.read_string(metadata.read(65537))
                deletion = dt.datetime.fromisoformat(parser['Trash Info']['DeletionDate']).timestamp()
                if deletion >= cutoff:
                    continue
                payload = os.stat(name, dir_fd=files_fd, follow_symlinks=False)
                if payload.st_uid != os.geteuid():
                    skipped += 1
                    continue
                if apply:
                    current = os.stat(info_name, dir_fd=info_fd, follow_symlinks=False)
                    if (current.st_ino, current.st_mtime_ns) != (st.st_ino, st.st_mtime_ns):
                        skipped += 1
                        continue
                    if stat.S_ISDIR(payload.st_mode):
                        if not shutil.rmtree.avoids_symlink_attacks:
                            raise RuntimeError('Нужна безопасная реализация rmtree с dir_fd')
                        shutil.rmtree(name, dir_fd=files_fd)
                    else:
                        os.unlink(name, dir_fd=files_fd)
                    os.unlink(info_name, dir_fd=info_fd)
                count += 1
            except (OSError, ValueError, KeyError, configparser.Error, UnicodeError):
                # Incomplete entries, inaccessible data and malformed dates stay intact.
                skipped += 1
    return count, skipped


def busy_packages():
    if Path('/var/lib/pacman/db.lck').exists():
        return True
    for proc in Path('/proc').iterdir():
        if not proc.name.isdigit():
            continue
        try:
            if (proc / 'comm').read_text().strip() in {'pacman', 'yay', 'paru', 'makepkg', 'paccache'}:
                return True
        except OSError:
            pass
    return False


def run(command, log=None):
    display = ' '.join(map(str, command))
    if str(command[0]).endswith('/paccache') and command.count('-c') > 3:
        display = 'paccache · каталоги AUR: ' + str(command.count('-c'))
    print('\n$ ' + display, flush=True)
    try:
        result = sp.run(list(map(str, command)), stdout=sp.PIPE, stderr=sp.STDOUT, text=True, timeout=1800)
        output = result.stdout.strip()
        if output:
            print(output, flush=True)
        if log is not None:
            log.append({'command': list(map(str, command)), 'code': result.returncode, 'output': output})
        return result.returncode == 0
    except (OSError, sp.TimeoutExpired) as error:
        print(str(error), flush=True)
        if log is not None:
            log.append({'command': list(map(str, command)), 'code': -1, 'output': str(error)})
        return False


def save(path, data):
    temp = path.with_suffix('.tmp')
    temp.write_text(json.dumps(data, ensure_ascii=False, indent=2) + '\n')
    temp.chmod(0o600)
    temp.replace(path)


def system_phase(monthly):
    if os.geteuid() != 0 or not os.environ.get('SUDO_UID'):
        raise RuntimeError('Системный этап запускается только через sudo из weekly-clean.')
    if busy_packages():
        raise RuntimeError('Идёт обновление или сборка пакетов; повтори очистку после завершения.')
    ok = run(['/usr/bin/paccache', '-rk2', '--min-mtime', '7 days ago'])
    if monthly:
        # Only archived journal files; active journals and pacman.log are retained.
        ok = run(['/usr/bin/journalctl', '--vacuum-time=30days']) and ok
    return 0 if ok else 1


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--apply', action='store_true', help='Выполнить очистку; без флага — только просмотр')
    parser.add_argument('--dry-run', action='store_true', help='Только просмотр, без sudo и удаления')
    parser.add_argument('--pause', action='store_true', help='Оставить окно с итогом открытым')
    parser.add_argument('--system', action='store_true', help=argparse.SUPPRESS)
    parser.add_argument('--monthly', action='store_true', help=argparse.SUPPRESS)
    args = parser.parse_args()
    if args.system:
        if args.apply or args.dry_run or args.pause:
            parser.error('Неверные аргументы системного этапа')
        return system_phase(args.monthly)
    if args.monthly:
        parser.error('Месячный этап включается автоматически раз в 30 дней')
    if os.geteuid() == 0:
        parser.error('Запускай без sudo: пароль будет запрошен только для системного этапа')
    if args.apply and args.dry_run:
        parser.error('Выбери --apply или --dry-run')
    apply = args.apply
    os.umask(0o077)
    STATE.mkdir(parents=True, exist_ok=True, mode=0o700)
    (STATE.parent / 'workstation-update').mkdir(parents=True, exist_ok=True, mode=0o700)
    with (STATE / 'lock').open('a') as lock, (STATE.parent / 'workstation-update').joinpath('lock').open('a') as update_lock:
        for handle in (lock, update_lock):
            try:
                fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                raise RuntimeError('Очистка или upd/yupd уже выполняется.')
        if busy_packages():
            raise RuntimeError('Сначала заверши обновление или сборку пакетов.')
        previous = json.loads((STATE / 'state.json').read_text()) if (STATE / 'state.json').exists() else {}
        monthly = month_due(previous.get('last_monthly_success'))
        print('ОЧИСТКА · ' + ('выполнение' if apply else 'предварительный просмотр'), flush=True)
        print('Pacman и AUR: сохранить 2 версии каждого пакета и все архивы моложе 7 дней.')
        print('Миниатюры: только файлы без обращений за 14 дней.')
        print('Месячный этап: ' + ('нужен' if monthly else 'пока не нужен'))
        print('Месячный этап: pip-кэш старше 30 дней, uv prune, npm verify, архивные журналы старше 30 дней.')
        print('AyuGram Desktop: файлы без обращений за 7 дней. Корзины: выброшенное более 30 дней назад.')
        print('Остальные загрузки, пакеты, исходники AUR, VM, снимки и резервные копии сохраняются.\n')
        free_before = shutil.disk_usage(HOME).free
        log = []
        ok = True
        if apply:
            # Obtain credentials before touching any user cache. No sudoers changes.
            if not run(['/usr/bin/sudo', '-v'], log):
                return 1
            command = ['/usr/bin/sudo', '/usr/bin/python', Path(__file__).resolve(), '--system']
            if monthly:
                command.append('--monthly')
            ok = run(command, log)
        else:
            print('Системный этап при запуске: sudo paccache -rk2 --min-mtime "7 days ago"')
        yay = HOME / '.cache/yay'
        cache_dirs = []
        if yay.is_dir() and not yay.is_symlink() and yay.resolve() == yay.absolute():
            cache_dirs = [p for p in sorted(yay.iterdir()) if p.is_dir() and not p.is_symlink()]
        if cache_dirs:
            cmd = ['/usr/bin/paccache', '-rk2' if apply else '-dqvk2', '--min-mtime', '7 days ago']
            for folder in cache_dirs:
                cmd += ['-c', folder]
            # paccache alone knows package version ordering and paired signatures.
            ok = run(cmd, log) and ok
        deleted = 0
        for folder, days in [(HOME / '.cache/thumbnails', 14), (HOME / 'Downloads/AyuGram Desktop', 7)] + ([(HOME / '.cache/pip', 30)] if monthly else []):
            count, size = old_files(folder, days, apply)
            deleted += size
            item = {'cache': str(folder), 'files': count, 'bytes': size, 'applied': apply}
            log.append(item)
            print(f'\n{folder.name}: {count} файлов · {human(size)}' + ('' if apply else ' — кандидаты'))
        for root in trash_roots():
            count, skipped = old_trash(root, 30, apply)
            log.append({'trash': str(root), 'entries': count, 'skipped': skipped, 'applied': apply})
            print(f'\nКорзина {root}: {count} объектов' + ('' if apply else ' — кандидаты'))
            if skipped:
                print(f'Сохранено объектов без надёжных метаданных или доступа: {skipped}')
        if monthly:
            for program, command in [('uv', ['uv', '--offline', '--no-config', 'cache', 'prune', '--cache-dir', str(HOME / '.cache/uv')]),
                                     ('npm', ['npm', 'cache', 'verify', '--cache', str(HOME / '.npm')])]:
                if shutil.which(program):
                    if apply:
                        ok = run(command, log) and ok
                    else:
                        print('\nМесячный этап: ' + ' '.join(command) + ' (размер покажет сама утилита)')
        print('\nПакеты-сироты — только справка, автоматического удаления нет:')
        result = sp.run(['/usr/bin/pacman', '-Qdtq'], capture_output=True, text=True)
        orphans = result.stdout.splitlines()
        log.append({'orphans_not_removed': orphans})
        if orphans:
            print(f'Найдено: {len(orphans)}. ' + ', '.join(orphans[:10]))
            if len(orphans) > 10:
                print('Полный список сохранён в отчёте.' if apply else 'Полный список: pacman -Qdtq')
        else:
            print('Нет.' if result.returncode == 1 else result.stderr.strip() or 'Нет.')
        if apply:
            now = time.time()
            if ok:
                previous['last_weekly_success'] = now
                if monthly:
                    previous['last_monthly_success'] = now
                save(STATE / 'state.json', previous)
            summary = {'finished': dt.datetime.now().astimezone().isoformat(), 'success': ok,
                       'monthly': monthly, 'free_before': free_before,
                       'free_after': shutil.disk_usage(HOME).free, 'operations': log}
            save(STATE / 'last-run.json', summary)
            print('\nИТОГ · ' + ('очистка завершена' if ok else 'есть ошибки — см. вывод выше'))
            print(f'Изменение свободного места: {human(summary["free_after"] - free_before)}.')
            print('На Btrfs снимки могут удерживать блоки удалённых файлов.')
            print('Отчёт: ' + str(STATE / 'last-run.json'))
        else:
            print('\nЭто просмотр. Для очистки: weekly-clean --apply')
        return 0 if ok else 1


if __name__ == '__main__':
    code = 1
    try:
        code = main()
    except (OSError, ValueError, RuntimeError, KeyboardInterrupt) as error:
        print('\nОчистка остановлена: ' + str(error), file=sys.stderr)
    finally:
        if '--pause' in sys.argv and sys.stdin.isatty():
            try:
                input('\nEnter — закрыть…')
            except (EOFError, KeyboardInterrupt):
                pass
    raise SystemExit(code)
