#!/usr/bin/env python3
"""Idempotent user services for Awesome; no WM replacement or power operations."""
import os,subprocess as sp
from pathlib import Path
H=Path.home();display=os.environ.get('DISPLAY',':0')
os.environ['QT_QPA_PLATFORMTHEME']='gtk3'
def processes():
 for p in Path('/proc').iterdir():
  if not p.name.isdigit():continue
  try:
   if p.stat().st_uid!=os.getuid():continue
   if b'DISPLAY='+os.fsencode(display) not in (p/'environ').read_bytes().split(b'\0'):continue
   yield int(p.name),(p/'comm').read_text().strip(),(p/'cmdline').read_bytes().split(b'\0')
  except OSError:pass
existing=list(processes())
# sxhkd's bspwm key grabs must not compete with native Awesome bindings.
for pid,name,args in existing:
 if name=='sxhkd':
  try:os.kill(pid,15)
  except ProcessLookupError:pass
state=H/'.local/state/panel-lab/awesome';state.mkdir(parents=True,exist_ok=True)
def once(name,args):
 if name in ('easyeffects','wispr-flow') and sp.run(['pgrep','-u',str(os.getuid()),'-x',name],stdout=sp.DEVNULL).returncode==0:return
 if any(comm==name or any(os.fsencode(name)==a.rsplit(b'/',1)[-1] for a in argv[:2]) for _,comm,argv in existing):return
 with (state/'session.log').open('ab') as f:sp.Popen([str(a) for a in args],stdin=sp.DEVNULL,stdout=f,stderr=f,start_new_session=True)
def call(args):sp.run([str(a) for a in args],stdout=sp.DEVNULL,stderr=sp.DEVNULL)
call(['dbus-update-activation-environment','--systemd','DISPLAY','XAUTHORITY','XDG_CURRENT_DESKTOP','XDG_SESSION_TYPE','XDG_SESSION_DESKTOP','QT_QPA_PLATFORMTHEME'])
call(['xsetroot','-cursor_name','left_ptr'])
call([H/'.local/bin/disable-middle-click'])
# A WM reload must preserve the active keyboard group.
keyboard=sp.run(['setxkbmap','-query'],capture_output=True,text=True).stdout
keyboard_fields=dict(line.split(':',1) for line in keyboard.splitlines() if ':' in line)
if keyboard_fields.get('layout','').strip()!='us,ru' or 'grp:alt_shift_toggle' not in keyboard_fields.get('options',''):
 call(['setxkbmap','-layout','us,ru','-option','grp:alt_shift_toggle'])
call(['xrdb','-merge',H/'.Xresources'])
call(['systemctl','--user','start','idle-screen-lock.service'])
call(['systemctl','--user','start','wallpaper-rotate.timer'])
once('dunst',['dunst'])
once('xsettingsd',['xsettingsd'])
call(['systemctl','--user','start','throne.service'])
call(['systemctl','--user','start','udiskie.service'])
once('picom',['picom','--config',H/'.config/picom/picom.conf'])
once('greenclip',['greenclip','daemon'])
once('flameshot',['flameshot'])
once('gammastep',['gammastep','-m','randr'])
once('battery-alert',[H/'bin/battery-alert'])

# One supervised audio service; keep an existing dictation session.
call(['systemctl','--user','start','easyeffects.service'])
once('wispr-flow',[H/'.local/bin/wispr-flow','--hidden'])
