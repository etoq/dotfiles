#!/bin/env bash
choice="$(printf '  reboot\n  poweroff\n  suspend\n  lock\n  logout' \
  | fzf --no-sort \
    --cycle --gutter ' ' --pointer '▌' \
    --color 'bg:#183039,bg+:#183039,fg:#C5D6D8,hl:#DE7C86,pointer:#DE7C86' \
    --prompt '  ')"

case "$choice" in
  *reboot)   systemctl reboot ;;
  *poweroff) systemctl poweroff ;;
  *suspend)  systemctl suspend || notify-send "Сон не выполнен" "Проверь настройки: ~/.local/bin/check-sleep-callback" ;;
  *lock)     betterlockscreen -l dimblur;;
  *logout)
    if [[ "${PANEL_WM:-${XDG_CURRENT_DESKTOP:-bspwm}}" == *awesome* ]]; then
      awesome-client "awesome.quit()"
    else
      bspc quit
    fi ;;
esac
