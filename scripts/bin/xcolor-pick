#!/usr/bin/env bash
set -euo pipefail
# Original Gpick floating picker; Win+Shift+X keeps its historical command name.
if ! command -v gpick >/dev/null 2>&1; then
    notify-send 'Пипетка Gpick' 'Нужен пакет gpick: sudo pacman -S gpick' || true
    exit 1
fi
color=$(gpick -pso --no-newline) || exit 0
[[ "$color" =~ ^#[[:xdigit:]]{6}$ ]] || exit 0
preview_dir="${XDG_CACHE_HOME:-$HOME/.cache}/gpick-swatches"
mkdir -p "$preview_dir"
swatch="$preview_dir/${color#\#}.png"
magick -size 100x100 "xc:$color" "$swatch"
printf '%s' "$color" | xclip -selection clipboard
notify-send -a Gpick --icon="$swatch" 'Цвет скопирован' "$color" --expire-time=5000
