#!/usr/bin/env bash
# Detect the actual battery; warn once per discharge cycle.
set -u
last=NONE
check_battery() {
    local battery="$1" capacity status
    [[ -r "$battery/capacity" && -r "$battery/status" ]] || return 0
    read -r capacity < "$battery/capacity"
    read -r status < "$battery/status"
    [[ "$capacity" =~ ^[0-9]+$ ]] || return 0
    if [[ "$status" == Discharging ]]; then
        if (( capacity <= 10 )) && [[ "$last" != CRITICAL ]]; then
            notify-send -u critical 'Battery critical' "${capacity}% remaining"
            last=CRITICAL
        elif (( capacity <= 25 )) && [[ "$last" != LOW && "$last" != CRITICAL ]]; then
            notify-send -u normal 'Battery low' "${capacity}% remaining"
            last=LOW
        fi
    else
        last=NONE
    fi
}
if [[ "${1:-}" == --once ]]; then
    check_battery "${2:-/sys/class/power_supply/BAT0}"
    exit
fi
while :; do
    for battery in /sys/class/power_supply/*; do
        [[ -r "$battery/type" ]] || continue
        [[ "$(<"$battery/type")" == Battery ]] || continue
        check_battery "$battery"
    done
    sleep 60
done
