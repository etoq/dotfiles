# Values
if [ "$#" -gt 0 ]; then
    TEXT=$1
else
    TEXT=$(cat <<'SAMPLE'
abcd efg hijk lmno pqrs tuv wxyz
ABCD EFG HIJK LMNO PQRS TUV WXYZ
  1234567890       ,./\;'[]-=`
  !@#$%%^&*()      <>?|:"{}_+~
SAMPLE
)
fi
STYLES="${2:-normal bold italic}"
printf '\n'
for style in $STYLES; do
    case "$style" in
        normal) printf '\033[0m%s\033[0m\n' "$TEXT" ;;
        bold)   printf '\033[1m%s\033[0m\n' "$TEXT" ;;
        italic) printf '\033[3m%s\033[0m\n' "$TEXT" ;;
    esac
done
printf '\n'
