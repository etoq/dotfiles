#!/usr/bin/env python3
"""Suspend with verified NVIDIA callback configuration and picom stopped."""
import json
import os
from pathlib import Path
import signal
import subprocess
import sys
import time

home = Path.home()
if os.geteuid() == 0:
    sys.exit("Run without sudo, from the graphical session.")
if sys.argv[1:] not in ([], ["--check"]):
    sys.exit("Usage: sleep-nvidia [--check]")
subprocess.run([str(home / ".local/bin/check-sleep-callback")], check=True)
jobs = []
for path in Path("/proc").iterdir():
    if not path.name.isdigit():
        continue
    try:
        if path.stat().st_uid != os.getuid() or (path / "comm").read_text().strip() != "picom":
            continue
        args = [os.fsdecode(a) for a in (path / "cmdline").read_bytes().split(b"\0") if a]
        jobs.append((int(path.name), args, os.readlink(path / "cwd")))
    except FileNotFoundError:
        continue
if len(jobs) > 1:
    sys.exit("Multiple picom processes: review before testing.")
if sys.argv[1:] == ["--check"]:
    print("Preflight passed. Picom processes:", len(jobs), "No sleep was requested.")
    sys.exit(0)
state = home / ".local/state/sleep-callback"
state.mkdir(parents=True, exist_ok=True)
(state / "picom-before.json").write_text(json.dumps(jobs, ensure_ascii=False, indent=2))
print("Suspending with picom temporarily stopped.", flush=True)
stopped = []
try:
    for pid, args, cwd in jobs:
        os.kill(pid, signal.SIGTERM)
        stopped.append((args, cwd))
        deadline = time.monotonic() + 5
        proc = Path(f"/proc/{pid}")
        while proc.exists() and time.monotonic() < deadline:
            try:
                process_state = (proc / "stat").read_text().split(")", 1)[1].split()[0]
            except FileNotFoundError:
                break
            if process_state == "Z":
                break
            time.sleep(0.1)
        else:
            if proc.exists():
                stopped.pop()
                sys.exit("Picom did not stop: sleep cancelled.")
    subprocess.run(["systemctl", "suspend"], check=True)
finally:
    for args, cwd in stopped:
        with (state / "picom.log").open("ab") as log:
            subprocess.Popen(["/usr/bin/picom", *args[1:]], cwd=cwd,
                             stdin=subprocess.DEVNULL, stdout=log, stderr=log,
                             start_new_session=True)
print("Suspend command returned; picom restored. Check the display and applications.")
