#!/bin/bash
set -eu
message="${SMARTD_MESSAGE:-Storage maintenance failed; inspect the system journal.}"
/usr/bin/logger -p daemon.err -t workstation-storage -- "$message"
if [ -S /run/user/1000/bus ]; then
    /usr/bin/runuser -u eto -- /usr/bin/env DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus /usr/bin/notify-send -u critical -- 'Состояние диска' "$message" || true
fi
