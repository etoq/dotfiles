# reloads sxhkd configuration:
super + Escape + r
    pkill -x sxhkd; sxhkd & notify-send 'sxhkd' 'Reloaded config' -t 1500

# Launch Terminal
super + Return
    kitty --override font_size=14.7

# Hide or Unhide Polybar
super + p
	sh $HOME/bin/toggle-polybar

# Set random wallpaper
super + w
	sh $HOME/bin/random_wallpaper

# Alt+Shift is handled directly by XKB (US/RU).

super + d
    ~/.local/bin/panel-action launcher

super + s
    ~/.local/bin/desktop-app open localsend

super + shift + d
    ~/.local/bin/desktop-app open discord

super + shift + a
    ~/.local/bin/desktop-app open chatgpt

super + shift + l
    betterlockscreen -l dimblur

super + shift + {z,o,s,n,p,t,c,v,x,k,e,r}
	{zen, \
    obsidian, \
    throne, \
	kitty -- yazi, \
	pavucontrol, \
	"$HOME/.local/bin/AyuGram", \
	sh $HOME/bin/calculator, \
	"$HOME/.local/bin/panel-action" vm-menu, \
	"$HOME/bin/xcolor-pick", \
	"$HOME/.local/bin/tiffany-calendar", \
	rofi -modi emoji -m -1 -show emoji, \
	kitty --class otter-tools -e "$HOME/.local/bin/study"}

# Менеджер буфера обмена (greenclip + fzf)
super + q
    ~/.config/sxhkd/clip.sh

super + shift + q
    greenclip clear && echo -n | xclip -selection clipboard && notify-send "History Clear!"

# Volume controls
XF86Audio{RaiseVolume,LowerVolume,Mute}
    sh $HOME/bin/volume{ --up, --down, --toggle}

# Brightness controls
XF86MonBrightness{Up,Down}
    sh $HOME/bin/brightness{ --up, --down}

# screenshot
Print
    flameshot gui

#
# BSPWM HOTKEYS
#

# close and kill
super + c
    bspc node -c

# alternate between the tiled and monocle layout
super + space
	bspc node -t "~"{floating,tiled}


#
# state/flags
#

# set the window state
super + {t,ctrl + t,f}
	bspc node -t {tiled,pseudo_tiled,fullscreen}
	

# Change focus to next window, including floating window
alt + {_,shift + }Tab
    bspc node -f {next.local,prev.local}
 
#
# focus/swap
#


# focus the last node/desktop
super + {grave,Tab}
	bspc {node,desktop} -f last

# send focus window to current desktop
super + {_,shift + }{1-9,0}
	bspc {desktop -f,node -d} '^{1-9,10}'

#
# preselect
#

# preselect the ratio
super + ctrl + {1-9}
	bspc node -o 0.{1-9}

# cancel the preselection for the focused nod
super + ctrl + space
	bspc node -p cancel

# cancel the preselection for the focused desktop
super + ctrl + shift + space
	bspc query -N -d | xargs -I id -n 1 bspc node id -p cancel

#
# move/resize
#

# Expanding windows
super + control + {h,j,k,l}
    bspc node -z {left -20 0,right 20 0,top 0 -20,bottom 0 20} 

# Send the window to another edge of the screen
super + {_,alt + }{h,j,k,l}
    bspc node -{f,s} {west,south,north,east}

# set the node flags
super + ctrl + {m,x,y,z}
	bspc node -g {marked,locked,sticky,private}

# swap the current node and the biggest window


# Tiffany Control Deck: tools, sound and brightness
super + shift + b
    "$HOME/.local/bin/panel-switch"


# Ghidra, consistent with Awesome
super + shift + g
    "$HOME/.local/bin/panel-action" ghidra
