{
  "enabled": false,
  "destination": {
    "provider": "proton-drive",
    "remote_directory": "/my-files/Workstation-zer0",
    "client": "official-cli",
    "authentication": "browser-and-os-keychain",
    "connected": false
  },
  "encryption_required": true,
  "sources": [
    "dotfiles",
    "Documents/obsidian",
    "Projects",
    "notes",
    "rednotes",
    ".config/ghidra",
    ".config/Throne",
    ".ssh",
    ".local/share/keyrings",
    ".config/keepassxc"
  ],
  "exclude": [
    "**/__pycache__",
    "**/node_modules",
    "**/.venv",
    "**/.cache",
    "dotfiles/.git"
  ],
  "schedule": null,
  "note": "Add the private .kdbx path to sources and keepass_sources locally. Timers require enabled=true; retention requires retention.enabled=true. Never commit vaults or authentication data.",
  "encryption": "Proton Drive client-side end-to-end encryption",
  "keepass_sources": [],
  "storage": {
    "budget_bytes": 2000000000,
    "reserve_bytes": 100000000,
    "max_archive_bytes": 900000000
  },
  "retention": {
    "enabled": false,
    "full_versions": 1,
    "keepass_daily_versions": 14,
    "delete_only_after_restore_verification": true
  }
}
