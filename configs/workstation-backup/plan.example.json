{
  "enabled": false,
  "destination": {
    "provider": "proton-drive",
    "remote_directory": "/my-files/Workstation-zer0",
    "client": "official-cli",
    "authentication": "browser-and-os-keychain",
    "connected": false
  },
  "encryption_required": true,
  "sources": [
    "dotfiles",
    "Documents/obsidian",
    "Projects",
    "notes",
    "rednotes",
    ".config/ghidra",
    ".config/Throne",
    ".ssh",
    ".local/share/keyrings"
  ],
  "exclude": [
    "**/__pycache__",
    "**/node_modules",
    "**/.venv",
    "**/.cache"
  ],
  "schedule": null,
  "note": "Provider selected. Awaiting browser login and explicit first backup launch; no archives or uploads created.",
  "encryption": "Proton Drive client-side end-to-end encryption"
}
