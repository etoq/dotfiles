set window-title-basename "true"
set selection-clipboard "clipboard"

# Black Tiffany color theme
set notification-error-bg       "#DE7C86" # Red
set notification-error-fg       "#C5D6D8" # Foreground
set notification-warning-bg     "#D8B77B" # Orange
set notification-warning-fg     "#183039" # Selection
set notification-bg             "#080D10" # Background
set notification-fg             "#C5D6D8" # Foreground

set completion-bg               "#080D10" # Background
set completion-fg               "#7E999F" # Comment
set completion-group-bg         "#080D10" # Background
set completion-group-fg         "#7E999F" # Comment
set completion-highlight-bg     "#183039" # Selection
set completion-highlight-fg     "#C5D6D8" # Foreground

set index-bg                    "#080D10" # Background
set index-fg                    "#C5D6D8" # Foreground
set index-active-bg             "#183039" # Current Line
set index-active-fg             "#C5D6D8" # Foreground

# 282a36
set inputbar-bg                 "#080D10" # Background
set inputbar-fg                 "#C5D6D8" # Foreground
set statusbar-bg                "#080D10" # Background
set statusbar-fg                "#C5D6D8" # Foreground

set highlight-color "#183039" # Orange
set highlight-active-color      "#0ABAB5" # Pink

set default-bg                  "#080D10" # Background
set default-fg                  "#C5D6D8" # Foreground

set render-loading              true
set render-loading-fg           "#080D10" # Background
set render-loading-bg           "#C5D6D8" # Foreground

#
# Recolor mode settings
#

set recolor-lightcolor          "#080D10" # Background
set recolor-darkcolor           "#C5D6D8" # Foreground

#
# Startup options
#
set adjust-open width
set recolor true
