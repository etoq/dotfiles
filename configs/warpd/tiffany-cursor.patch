--- /dev/null
+++ b/src/platform/linux/X/theme_cursor.c
@@ -0,0 +1,97 @@
+/* Keep the configured theme's arrow silhouette/hotspot; tint its dark fill. */
+#include "X.h"
+#include <X11/Xcursor/Xcursor.h>
+#include <X11/extensions/Xrender.h>
+
+static Window cursor_win;
+static unsigned int hot_x, hot_y;
+static char loaded_theme[256], loaded_color[32];
+static int loaded_size;
+
+void x_theme_cursor_hide(void)
+{
+    if (cursor_win)
+        XUnmapWindow(dpy, cursor_win);
+}
+
+static void create_theme_cursor(void)
+{
+    const char *theme = config_get("cursor_theme");
+    const char *color = config_get("cursor_color");
+    int size = config_get_int("cursor_theme_size");
+    if (cursor_win && loaded_size == size && !strcmp(theme, loaded_theme)
+        && !strcmp(color, loaded_color))
+        return;
+
+    XcursorImage *img = XcursorLibraryLoadImage("left_ptr", theme, size);
+    XVisualInfo visual;
+    if (!img || !XMatchVisualInfo(dpy, DefaultScreen(dpy), 32, TrueColor, &visual)) {
+        fprintf(stderr, "Unable to load theme pointer or 32-bit visual\n");
+        exit(1);
+    }
+    XRenderPictFormat *fmt = XRenderFindVisualFormat(dpy, visual.visual);
+    if (!fmt || fmt->type != PictTypeDirect || !fmt->direct.alphaMask) {
+        fprintf(stderr, "Theme pointer needs an ARGB visual\n");
+        exit(1);
+    }
+    uint32_t tint = parse_xcolor(color, NULL);
+    XImage *pixels = XCreateImage(dpy, visual.visual, 32, ZPixmap, 0, NULL,
+                                  img->width, img->height, 32, 0);
+    if (!pixels || !(pixels->data = calloc(img->height, pixels->bytes_per_line)))
+        exit(1);
+    for (unsigned int y = 0; y < img->height; ++y) {
+        for (unsigned int x = 0; x < img->width; ++x) {
+            uint32_t src = img->pixels[y * img->width + x];
+            unsigned int a = src >> 24;
+            /* Xcursor pixels are premultiplied: retain alpha and white outline. */
+            unsigned int lum = (((src >> 16) & 255) + ((src >> 8) & 255) + (src & 255)) / 3;
+            unsigned int out = a << 24;
+            for (int shift = 0; shift <= 16; shift += 8) {
+                unsigned int t = (tint >> shift) & 255;
+                unsigned int v = lum + ((a > lum ? a - lum : 0) * t + 127) / 255;
+                out |= (v > a ? a : v) << shift;
+            }
+            XPutPixel(pixels, x, y, out);
+        }
+    }
+    Pixmap bg = XCreatePixmap(dpy, DefaultRootWindow(dpy), img->width, img->height, 32);
+    GC gc = XCreateGC(dpy, bg, 0, NULL);
+    XPutImage(dpy, bg, gc, pixels, 0, 0, 0, 0, img->width, img->height);
+    XFreeGC(dpy, gc);
+    XDestroyImage(pixels);
+    if (cursor_win)
+        XDestroyWindow(dpy, cursor_win);
+    /* The background pixmap keeps the anti-aliased theme alpha under Picom. */
+    Colormap cmap = XCreateColormap(dpy, DefaultRootWindow(dpy), visual.visual, AllocNone);
+    XSetWindowAttributes attrs = {.override_redirect = True, .colormap = cmap,
+                                  .border_pixel = 0, .background_pixmap = bg};
+    cursor_win = XCreateWindow(dpy, DefaultRootWindow(dpy), -1000, -1000,
+                               img->width, img->height, 0, 32, InputOutput,
+                               visual.visual, CWOverrideRedirect | CWColormap
+                               | CWBorderPixel | CWBackPixmap, &attrs);
+    XFreeColormap(dpy, cmap);
+    XFreePixmap(dpy, bg);
+    XClassHint hint = {.res_name = "warpd", .res_class = "warpd"};
+    XSetClassHint(dpy, cursor_win, &hint);
+    /* Transparent to pointer events, including clicks and drags. */
+    XserverRegion empty = XFixesCreateRegion(dpy, NULL, 0);
+    XFixesSetWindowShapeRegion(dpy, cursor_win, ShapeInput, 0, 0, empty);
+    XFixesDestroyRegion(dpy, empty);
+    Atom shadow = XInternAtom(dpy, "_COMPTON_SHADOW", False);
+    unsigned long no_shadow = 0;
+    XChangeProperty(dpy, cursor_win, shadow, XA_CARDINAL, 32, PropModeReplace,
+                    (unsigned char *)&no_shadow, 1);
+    hot_x = img->xhot;
+    hot_y = img->yhot;
+    XcursorImageDestroy(img);
+    snprintf(loaded_theme, sizeof loaded_theme, "%s", theme);
+    snprintf(loaded_color, sizeof loaded_color, "%s", color);
+    loaded_size = size;
+}
+
+void x_screen_draw_theme_cursor(screen_t scr, int x, int y)
+{
+    create_theme_cursor();
+    XMoveWindow(dpy, cursor_win, scr->x + x - (int)hot_x, scr->y + y - (int)hot_y);
+    XMapRaised(dpy, cursor_win);
+}
