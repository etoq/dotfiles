[Unit]
Description=KOReader book and annotation synchronization
After=network-online.target
[Service]
ExecStart=%h/.local/opt/syncthing-linux-amd64-v2.1.7/syncthing serve --home=%h/.local/state/koreader-syncthing --no-browser --no-upgrade
Restart=on-failure
RestartSec=10
UMask=0077
[Install]
WantedBy=default.target
